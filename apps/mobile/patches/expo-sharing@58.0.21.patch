diff --git a/ios/shared/PendingPosting.swift b/ios/shared/PendingPosting.swift
new file mode 100644
index 0000000000000000000000000000000000000000..356066aca1380e0ea8662279d23d1f19733e6bd5
--- /dev/null
+++ b/ios/shared/PendingPosting.swift
@@ -0,0 +1,65 @@
+import Foundation
+import CryptoKit
+
+// Private app-group handoff. No cookies, tokens, URL resolving or application writes.
+struct PostingShareContext: Codable {
+  let scope: String
+  let server: String
+  let updatedAt: TimeInterval
+}
+
+struct PendingPosting: Codable {
+  let context: PostingShareContext
+  let createdAt: TimeInterval
+  let payloads: [SharePayload]
+}
+
+struct PendingPostingStore {
+  let defaults: UserDefaults
+  private let contextKey = "reactive-resume.share-context"
+
+  func context(now: Date = Date()) -> PostingShareContext? {
+    defaults.synchronize()
+    guard let data = defaults.data(forKey: contextKey),
+      let context = try? JSONDecoder().decode(PostingShareContext.self, from: data),
+      (0...86_400).contains(now.timeIntervalSince1970 - context.updatedAt) else { return nil }
+    return context
+  }
+
+  func setContext(scope: String?, server: String?, now: Date = Date()) {
+    guard let scope, let server else {
+      defaults.removeObject(forKey: contextKey)
+      discard()
+      return
+    }
+    let digest = SHA256.hash(data: Data(scope.utf8)).map { String(format: "%02x", $0) }.joined()
+    if context(now: now)?.scope != digest { discard() }
+    let next = PostingShareContext(scope: digest, server: server, updatedAt: now.timeIntervalSince1970)
+    defaults.set(try? JSONEncoder().encode(next), forKey: contextKey)
+    defaults.synchronize()
+  }
+
+  func save(_ payloads: [SharePayload], for selected: PostingShareContext, now: Date = Date()) -> Bool {
+    guard context(now: now)?.scope == selected.scope, (1...2).contains(payloads.count),
+      payloads.allSatisfy({ ($0.type == .text || $0.type == .url) && $0.value.utf16.count <= 100_000 }),
+      let data = try? JSONEncoder().encode(PendingPosting(context: selected, createdAt: now.timeIntervalSince1970, payloads: payloads))
+      else { return false }
+    defaults.set(data, forKey: SHARE_INTO_DEFAULTS_KEY)
+    defaults.synchronize()
+    return true
+  }
+
+  func consume(now: Date = Date()) -> [SharePayload] {
+    let data = defaults.data(forKey: SHARE_INTO_DEFAULTS_KEY)
+    discard()
+    guard let data, let pending = try? JSONDecoder().decode(PendingPosting.self, from: data),
+      (0...900).contains(now.timeIntervalSince1970 - pending.createdAt),
+      context(now: now)?.scope == pending.context.scope else { return [] }
+    return pending.payloads
+  }
+
+  func discard() {
+    defaults.removeObject(forKey: SHARE_INTO_DEFAULTS_KEY)
+    defaults.synchronize()
+  }
+}
