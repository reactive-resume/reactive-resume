#: src/features/auth/ConsentScreen.tsx
msgid "This connection request is invalid or has expired. Start the connection again from your client."
msgstr "ಈ ಸಂಪರ್ಕ ವಿನಂತಿ ಅಮಾನ್ಯವಾಗಿದೆ ಅಥವಾ ಅವಧಿ ಮೀರಿದೆ. ನಿಮ್ಮ ಕ್ಲೈಂಟ್‌ನಿಂದ ಸಂಪರ್ಕವನ್ನು ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ."

#: src/features/settings/first-send.ts
