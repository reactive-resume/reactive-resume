msgstr "Numri juaj i telefonit është shkruar në një formë të pazakontë."

#: src/features/builder/basics/BasicsScreen.tsx
msgid "Your photo"
msgstr "Fotografia juaj"

#: src/features/settings/ProfileScreen.tsx
msgid "Your profile changed on another device"
msgstr "Profili ndryshoi në një pajisje tjetër"

#: src/features/career/schedules.tsx
msgid "Your provider may charge for each run"
msgstr "Ofruesi mund të faturojë për çdo ekzekutim"

#: src/features/settings/AIScreen.tsx
msgid "Your provider may charge your account for requests made with your API key."
msgstr "Ofruesi juaj mund ta tarifojë llogarinë tuaj për kërkesat e bëra me çelësin tuaj API."

#: src/features/settings/first-send.ts
msgid "Your recording"
msgstr "Regjistrimi juaj"

#: src/features/builder/description/improve.ts
msgid "your request"
msgstr "kërkesa juaj"

#: src/api/ai-consent.ts
msgid "Your request and relevant resume, letter, job posting, application, career information, conversation history, and attachments are sent through your server to this AI provider, according to the feature and context you selected. They can contain personal information."
msgstr "Kërkesa dhe rezymeja juaj përkatëse, letra, postimi i punës, aplikacioni, informacioni i karrierës, historia e bisedave dhe bashkëngjitjet dërgohen përmes serverit tuaj te ky ofrues i AI, sipas veçorisë dhe kontekstit që keni zgjedhur. Ato mund të përmbajnë informacione personale."

#: src/features/settings/first-send.ts
msgid "your resume and facts"
msgstr "CV-ja dhe faktet tuaja"

#: src/features/settings/first-send.ts
msgid "Your resume and saved facts"
msgstr "CV-ja dhe faktet e ruajtura"

#: src/features/builder/check/issues.ts
msgid "Your resume has a photo"
msgstr "CV-ja juaj ka një foto"

#: src/features/public/ats-messages.ts
msgid "Your resume uses \"I\" and \"my\"."
msgstr "CV-ja juaj përdor \"I\" dhe \"my\"."

#: src/features/auth/WelcomeScreen.tsx
msgid "Your resume, from first draft to the offer."
msgstr "CV-ja juaj, nga drafti i parë tek oferta."

#: src/features/applications/InsightsScreen.tsx
msgid "Your search over the last {range} days."
msgstr "Kërkimi juaj në {range} ditët e fundit."

#: src/api/ai-consent.ts
msgid "Your search terms and public links go through your server to the selected web services and sites. No AI provider is used."
msgstr "Termet e tua të kërkimit dhe lidhjet publike kalojnë përmes serverit tënd te shërbimet dhe sitet e web-it të përzgjedhura. Nuk përdor asnjë ofrues IA."

#: src/features/documents/import.tsx
msgid "Your server reads the PDF. It isn't sent to an AI provider."
msgstr "Serveri juaj lexon PDF-në. Nuk dërgohet te një ofrues IA."

#: src/api/ai-consent.ts
msgid "Your server sends a test prompt and the saved API key to this provider."
msgstr "Serveri juaj dërgon një kërkesë testimi dhe çelësin e ruajtur API te ky ofrues."

#: src/data/failures.ts
msgid "Your session expired"
msgstr "Seanca skadoi"

#: src/features/settings/sign-out-copy.ts
msgid "Your session expired. Sign in again to sync them."
msgstr "Seanca skadoi. Hyni sërish për t'i sinkronizuar."

#: src/features/builder/share/share-screen.tsx
msgid "Your short link"
msgstr "Lidhja juaj e shkurtër"

#: src/features/builder/share/web-page-screen.tsx
msgid "Your short link rx.cv/{username} opens this one."
msgstr "Lidhja juaj e shkurtër rx.cv/{username} hap këtë."

#: src/features/applications/actions.ts
msgid "Your stages changed somewhere else. They've been refreshed; try again."
msgstr "Fazat tuaja ndryshuan diku tjetër. U rifreskuan; provoni përsëri."

#: src/features/builder/share/share-screen.tsx
msgid "Your web page address"
msgstr "Adresa e faqes suaj të internetit"

#: src/features/builder/share/share-screen.tsx
msgid "Your web page is live"
msgstr "Faqja juaj e internetit është online"

#: src/api/ai-consent.ts
msgid "Your web settings changed. Nothing was sent; try again."
msgstr "Parametrat e tua të web-it ndryshuan. Asgjë nuk u dërgua; provo përsëri."

#: src/features/applications/InsightsScreen.tsx
msgid "Your whole search so far."
msgstr "I gjithë kërkimi juaj deri tani."

#: src/features/builder/assistant/proposals-screen.tsx
msgid "Your wording"
msgstr "Formulimi yt"

#: src/features/today/screen.tsx
msgid "Your work is lost when you sign out or the session ends. Create an account or sign in to keep your resumes, cover letters and applications."
msgstr "Puna jote humbet kur del nga llogaria ose kur seanca përfundon. Krijo një llogari ose kyçu për të ruajtur CV-të, letrat motivuese dhe aplikimet e tua."

