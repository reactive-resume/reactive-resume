#: src/features/ats-checker/messages.ts
msgid "This file contains white-on-white text."
msgstr "ഈ ഫയലിൽ വെള്ളയിൽ വെള്ള ടെക്സ്റ്റ് അടങ്ങിയിരിക്കുന്നു."

#: src/features/documents/import-file.ts
msgid "This file couldn't be read. Choose a PDF, Word, JSON or LinkedIn export (.zip)."
msgstr "ഈ ഫയൽ വായിക്കാൻ കഴിഞ്ഞില്ല. ഒരു PDF, Word, JSON അല്ലെങ്കിൽ LinkedIn എക്‌സ്‌പോർട്ട് (.zip) തിരഞ്ഞെടുക്കുക."

#: src/features/ats-checker/original-page.tsx
