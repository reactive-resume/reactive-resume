{
	"name": "mobile",
	"version": "0.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"start:storyboard": "APP_VARIANT=storyboard EXPO_PUBLIC_STORYBOARD=1 expo start",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"typecheck": "tsrs --noEmit",
		"lingui:extract": "lingui extract --clean && node scripts/seed-locales.mjs",
		"test": "jest",
		"test:ci": "jest --ci --testPathIgnorePatterns src/dev/storyboard/edges.test.ts",
		"check:motion": "sh scripts/check-motion.sh",
		"check:bundle": "dir=$(mktemp -d) && trap 'rm -rf \"$dir\"' EXIT && TMPDIR=\"$dir\" expo export --output-dir \"$dir/dist\"",
		"icons": "node scripts/icons.mjs",
		"fidelity:ios": "node ../../.agents/handoff/mobile-final/tools/rn_capture.mjs screens --platform ios --scheme me.rxresu.storyboard --bundle-id me.rxresu.storyboard --out build/fidelity/ios && python3 ../../.agents/handoff/mobile-final/tools/fidelity.py build/fidelity/ios build/fidelity-report/ios --system-bars",
		"fidelity:android": "node ../../.agents/handoff/mobile-final/tools/rn_capture.mjs screens --platform android --scheme me.rxresu.storyboard --package me.rxresu.storyboard --out build/fidelity/android && python3 ../../.agents/handoff/mobile-final/tools/fidelity.py build/fidelity/android build/fidelity-report/android --system-bars",
		"motion:ios": "node ../../.agents/handoff/mobile-final/tools/rn_capture.mjs record --platform ios --scheme me.rxresu.storyboard --bundle-id me.rxresu.storyboard --probes all --out build/motion/ios && python3 ../../.agents/handoff/mobile-final/tools/motion_probe.py suite build/motion/ios build/motion/ios-report",
		"motion:android": "node ../../.agents/handoff/mobile-final/tools/rn_capture.mjs record --platform android --scheme me.rxresu.storyboard --package me.rxresu.storyboard --probes all --out build/motion/android && python3 ../../.agents/handoff/mobile-final/tools/motion_probe.py suite build/motion/android build/motion/android-report"
	},
	"dependencies": {
		"@formatjs/intl-displaynames": "catalog:",
		"@formatjs/intl-locale": "^5.4.2",
		"@formatjs/intl-pluralrules": "^7.0.2",
		"@formatjs/intl-relativetimeformat": "catalog:",
		"@lingui/core": "6.12.0",
		"@lingui/react": "6.12.0",
		"@orpc/client": "catalog:",
		"@orpc/tanstack-query": "^1.16.2",
		"@react-native-community/datetimepicker": "9.3.0",
		"@reactive-resume/ai": "workspace:*",
		"@reactive-resume/import": "workspace:*",
		"@reactive-resume/pdf": "workspace:*",
		"@reactive-resume/resume": "workspace:*",
		"@reactive-resume/schema": "workspace:*",
		"@reactive-resume/utils": "workspace:*",
		"@tanstack/react-query": "^5.107.0",
		"expo": "~58.0.23",
		"expo-asset": "catalog:",
		"expo-audio": "~58.0.11",
		"expo-auth-session": "~58.0.17",
		"expo-background-task": "catalog:",
		"expo-build-properties": "~58.0.0",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.15",
		"expo-crypto": "~58.0.7",
		"expo-dev-client": "~58.0.18",
		"expo-document-picker": "~58.0.4",
		"expo-file-system": "~58.0.13",
		"expo-font": "~58.0.11",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.18",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.16",
		"expo-localization": "~58.0.5",
		"expo-network": "~58.0.4",
		"expo-notifications": "~58.1.8",
		"expo-print": "~58.0.8",
		"expo-quick-actions": "catalog:",
		"expo-router": "~58.0.30",
		"expo-secure-store": "~58.0.2",
		"expo-sharing": "~58.0.22",
		"expo-splash-screen": "~58.0.13",
		"expo-sqlite": "~58.0.15",
		"expo-status-bar": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"expo-task-manager": "catalog:",
		"expo-web-browser": "~58.0.7",
		"immer": "^11.2.9",
		"react": "catalog:",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.5.0",
		"react-native-keyboard-controller": "1.23.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.1",
		"react-native-worklets": "0.13.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@babel/plugin-transform-parameters": "catalog:",
		"@babel/plugin-transform-unicode-sets-regex": "catalog:",
		"@lingui/babel-plugin-lingui-macro": "6.12.0",
		"@lingui/cli": "6.12.0",
		"@lingui/format-po": "6.12.0",
		"@lingui/metro-transformer": "6.12.0",
		"@orpc/server": "catalog:",
		"@reactive-resume/config": "workspace:*",
		"@testing-library/react-native": "catalog:",
		"@types/jest": "^30.0.0",
		"@types/react": "catalog:",
		"babel-preset-expo": "~58.0.24",
		"jest": "^30.2.0",
		"jest-expo": "~58.0.0",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@reactive-resume/api": "workspace:*"
	},
	"jest": {
		"preset": "jest-expo",
		"setupFiles": [
			"./jest.setup.ts"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		},
		"testMatch": [
			"<rootDir>/src/**/*.test.ts",
			"<rootDir>/src/**/*.test.tsx"
		],
		"transform": {
			"\\.mjs$": "babel-jest"
		},
		"transformIgnorePatterns": [
			"/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@lingui|@messageformat|uuid|@orpc|@sindresorhus|escape-string-regexp|immer))",
			"/node_modules/react-native-reanimated/plugin/",
			"/node_modules/@react-native/babel-preset/"
		],
		"resolver": "react-native-reanimated/jest/resolver"
	},
	"expo": {
		"install": {
			"exclude": [
				"typescript"
			]
		}
	}
}
