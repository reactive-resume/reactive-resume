#: src/routes/_home/-sections/footer.tsx
msgid "A free and open-source resume builder that makes it easy to create, update, and share your resume."
msgstr "'n Gratis oopbron-CV-bouer wat dit maklik maak om jou CV te skep, by te werk en te deel."

#: src/features/homepage/resume-sculpture.tsx
msgid "A free collection of accessible patterns for the web."
msgstr "’n Gratis versameling toeganklike patrone vir die web."

#: src/features/homepage/page.tsx
msgid "A free, open-source resume builder. Put your experience on the page, without fighting the formatting."
msgstr "’n Gratis, oopbron-CV-bouer. Plaas jou ervaring op die bladsy, sonder om met die formatering te worstel."

#: src/features/homepage/site-footer.tsx
msgid "A free, open-source resume builder. Yours to keep, yours to export, yours to host."
msgstr "’n Gratis, oopbron-CV-bouer. Joune om te hou, joune om uit te voer, joune om self te huisves."

