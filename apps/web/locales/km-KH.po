#: src/features/ats-checker/messages.ts
msgid "This file has no accessibility tags."
msgstr "ឯកសារនេះគ្មានស្លាកភាពងាយស្រួលប្រើប្រាស់ទេ។"

#: src/features/ats-checker/messages.ts
msgid "This file is encrypted."
msgstr "ឯកសារនេះត្រូវបានអថេរបំលែង។"

#: src/features/ats-checker/messages.ts
msgid "This file is large for a resume."
msgstr "ឯកសារនេះធំសម្រាប់ជាប្រវត្តិរូបសង្ខេប។"

#: src/features/ats-checker/messages.ts
msgid "This file is larger than many application forms accept."
msgstr "ឯកសារនេះធំជាងអ្វីដែលទម្រង់ដាក់ពាក្យជាច្រើនអនុញ្ញាត។"

#: src/features/documents/new-document-dialog.tsx
msgid "This file type can't be imported. Use a PDF, Word, Reactive Resume or JSON Resume file, or a LinkedIn export (.zip)."
msgstr "ប្រភេទឯកសារនេះមិនអាចនាំចូលបានទេ។ ប្រើឯកសារ PDF, Word, Reactive Resume ឬ JSON Resume ឬនាំចេញ LinkedIn (.zip) ។"

#: src/features/ats-checker/messages.ts
msgid "This file uses a lot of different fonts."
msgstr "ឯកសារនេះប្រើពុម្ពអក្សរផ្សេងគ្នាជាច្រើន។"

#: src/features/ats-checker/messages.ts
msgid "This file uses Type 3 fonts, which carry drawings instead of characters."
msgstr "ឯកសារនេះប្រើពុម្ពអក្សរ Type 3 ដែលផ្ទុករូបគូរជំនួសឱ្យតួអក្សរ។"

#: src/features/ats-checker/messages.ts
msgid "This is a PDF Portfolio: the visible page is only a cover."
msgstr "នេះជា PDF Portfolio៖ ទំព័រដែលមើលឃើញគឺគ្រាន់តែជាគម្រប។"

#: src/features/ats-checker/messages.ts
msgid "This is an XFA form, so most software reads only the empty shell."
msgstr "នេះជាទម្រង់ XFA ដូច្នេះកម្មវិធីភាគច្រើនអានតែសំបកទទេប៉ុណ្ណោះ។"

#: src/features/ats-checker/messages.ts
msgid "This is not a common resume page size."
msgstr "នេះមិនមែនជាទំហំទំព័រប្រវត្តិរូបសង្ខេបធម្មតាទេ។"

#: src/routes/builder/letter/-components/share-sheet.tsx
msgid "This letter and “{resumeName}” as two PDFs, named to match."
msgstr "សំបុត្រនេះ និង “{resumeName}” ជា PDFs ពីរ ដែលដាក់ឈ្មោះឱ្យត្រូវគ្នា។"

#: src/routes/builder/letter/-components/write-panel.tsx
msgid "This letter is locked. Unlock it from its menu to edit."
msgstr "សំបុត្រនេះត្រូវបានចាក់សោ។ ដោះសោវាពីម៉ឺនុយរបស់វាដើម្បីកែសម្រួល។"

#: src/routes/builder/letter/-components/write-panel.tsx
