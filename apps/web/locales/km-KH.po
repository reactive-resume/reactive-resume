#: src/routes/agent/-components/agent-chat.tsx
msgid "This action cannot be undone. It deletes the thread's messages and uploaded attachments. The working resume stays in your dashboard, and you can delete it separately."
msgstr "សកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។ វាលុបសាររបស់ខ្សែស្រឡាយ និងឯកសារភ្ជាប់ដែលបានផ្ទុកឡើង។ ប្រវត្តិរូបសង្ខេបដែលកំពុងប្រើនៅតែមាននៅក្នុងផ្ទាំងគ្រប់គ្រងរបស់អ្នក ហើយអ្នកអាចលុបវាដោយឡែក។"

#: src/routes/builder/$resumeId/-components/ai-assistant.tsx
msgid "This assistant could not be opened."
msgstr "មិនអាចបើកជំនួយការនេះបានទេ។"

#: src/features/auth/pages/consent.tsx
msgid "This connection request is invalid or has expired."
msgstr "សំណើ​តភ្ជាប់​នេះ​មិន​ត្រឹមត្រូវ ឬ​បាន​ផុត​កំណត់។"

#: src/features/cover-letters/editor.tsx
msgid "This cover letter changed elsewhere. Your edits are still here. Reload the latest version before saving again."
msgstr "លិខិតគម្របនេះបានផ្លាស់ប្តូរនៅកន្លែងផ្សេង។ ការកែសម្រួលរបស់អ្នកនៅតែនៅទីនេះ។ ផ្ទុកកំណែចុងក្រោយបំផុតឡើងវិញ មុនពេលរក្សាទុកម្តងទៀត។"

#: src/dialogs/api-key/create.tsx
msgid "This creates a new API key, which lets other programs read and change your resume data through the Reactive Resume API."
msgstr "វានឹងបង្កើតកូនសោ API ថ្មី ដែលអនុញ្ញាតឱ្យកម្មវិធីផ្សេងទៀតអាន និងផ្លាស់ប្តូរទិន្នន័យប្រវត្តិរូបសង្ខេបរបស់អ្នកតាមរយៈ Reactive Resume API។"

#: src/libs/resume/ats.ts
msgid "This date will not be read correctly."
msgstr "កាលបរិច្ឆេទនេះនឹងមិនត្រូវបានអានត្រឹមត្រូវទេ។"

#: src/routes/agent/-components/patch-approval-card.tsx
msgid "This edit request can no longer be answered."
msgstr "សំណើកែសម្រួលនេះមិនអាចឆ្លើយតបបានទៀតទេ។"

#: src/libs/resume/ats.ts
msgid "This email address will not be recognized."
msgstr "អាសយដ្ឋានអ៊ីមែលនេះនឹងមិនត្រូវបានទទួលស្គាល់ទេ។"

#: src/libs/resume/ats.ts
msgid "This entry has no dates."
msgstr "ធាតុនេះមិនមានកាលបរិច្ឆេទទេ។"

#: src/features/applications/components/application-detail-sheet.tsx
msgid "This entry will be permanently deleted. This can't be undone."
msgstr "ធាតុនេះនឹងត្រូវបានលុបជាអចិន្ត្រៃយ៍។ មិនអាចមិនធ្វើវិញបានទេ។"

#: src/dialogs/resume/import.tsx
msgid "This feature requires a connected AI provider. Please set one up in the settings."
msgstr "មុខងារនេះតម្រូវឱ្យមានអ្នកផ្តល់សេវា AI ដែលបានភ្ជាប់។ សូមដំឡើងមួយនៅក្នុងការកំណត់។"

#: src/features/ats-checker/messages.ts
msgid "This file contains form fields."
msgstr "ឯកសារនេះមានវាលទម្រង់។"

#: src/features/ats-checker/report/jd-coverage.tsx
msgid "This file contains text a reader cannot see, so some of these matches may be against it."
msgstr "ឯកសារនេះមានអត្ថបទដែលអ្នកអានមិនអាចមើលឃើញ ដូច្នេះការផ្គូផ្គងខ្លះទាំងនេះអាចប្រឆាំងនឹងវា។"

#: src/features/ats-checker/messages.ts
msgid "This file contains text drawn invisibly."
msgstr "ឯកសារនេះមានអត្ថបទដែលបានគូរដោយមើលមិនឃើញ។"

#: src/features/ats-checker/messages.ts
msgid "This file contains white-on-white text."
msgstr "ឯកសារនេះមានអត្ថបទពណ៌ស​លើផ្ទៃពណ៌ស។"

#: src/features/homepage/ats-playground.tsx
msgid "This file could not be read as a PDF. Export a new copy and try again."
msgstr "មិនអាចអានឯកសារនេះជា PDF បានទេ។ នាំចេញច្បាប់ចម្លងថ្មី ហើយសាកល្បងម្ដងទៀត។"

#: src/features/ats-checker/messages.ts
msgid "This file declares no language."
msgstr "ឯកសារនេះមិនបានប្រកាសភាសាណាមួយទេ។"

#: src/features/ats-checker/messages.ts
msgid "This file has no accessibility tags."
msgstr "ឯកសារនេះគ្មានស្លាកភាពងាយស្រួលប្រើប្រាស់ទេ។"

#: src/features/ats-checker/messages.ts
msgid "This file is encrypted."
msgstr "ឯកសារនេះត្រូវបានអថេរបំលែង។"

#: src/features/ats-checker/messages.ts
msgid "This file is large for a resume."
msgstr "ឯកសារនេះធំសម្រាប់ជាប្រវត្តិរូបសង្ខេប។"

#: src/features/ats-checker/messages.ts
msgid "This file is larger than many application forms accept."
msgstr "ឯកសារនេះធំជាងអ្វីដែលទម្រង់ដាក់ពាក្យជាច្រើនអនុញ្ញាត។"

#: src/features/ats-checker/messages.ts
msgid "This file uses a lot of different fonts."
msgstr "ឯកសារនេះប្រើពុម្ពអក្សរផ្សេងគ្នាជាច្រើន។"

#: src/features/ats-checker/messages.ts
msgid "This file uses Type 3 fonts, which carry drawings instead of characters."
msgstr "ឯកសារនេះប្រើពុម្ពអក្សរ Type 3 ដែលផ្ទុករូបគូរជំនួសឱ្យតួអក្សរ។"

#: src/libs/resume/ats.ts
msgid "This heading is not one parsers look for."
msgstr "ចំណងជើងនេះមិនមែនជាអ្នកវិភាគស្វែងរកទេ។"

#: src/features/ats-checker/messages.ts
msgid "This is a PDF Portfolio: the visible page is only a cover."
msgstr "នេះជា PDF Portfolio៖ ទំព័រដែលមើលឃើញគឺគ្រាន់តែជាគម្រប។"

#: src/features/homepage/feature-explorer.tsx
msgid "This is a sample edit. In the app, connect your own AI provider. Turn on Review edits to approve changes before they’re applied."
msgstr "នេះជាការកែសម្រួលគំរូ។ ក្នុងកម្មវិធី សូមភ្ជាប់អ្នកផ្តល់សេវា AI ផ្ទាល់ខ្លួនរបស់អ្នក។ បើក «ពិនិត្យការកែសម្រួល» ដើម្បីអនុម័តការផ្លាស់ប្ដូរមុនពេលអនុវត្ត។"

#: src/dialogs/resume/index.tsx
msgid "This is a URL-friendly name for your resume."
msgstr "នេះ​ជា​ឈ្មោះ​ងាយ​ស្រួល​សម្រាប់​ប្រើ​នៅ​ក្នុង URL សម្រាប់​ប្រវត្តិរូប​របស់​អ្នក។"

#: src/features/ats-checker/messages.ts
msgid "This is an XFA form, so most software reads only the empty shell."
msgstr "នេះជាទម្រង់ XFA ដូច្នេះកម្មវិធីភាគច្រើនអានតែសំបកទទេប៉ុណ្ណោះ។"

#: src/features/ats-checker/messages.ts
msgid "This is not a common resume page size."
msgstr "នេះមិនមែនជាទំហំទំព័រប្រវត្តិរូបសង្ខេបធម្មតាទេ។"

#: src/dialogs/api-key/create.tsx
msgid "This key is shown only once. Copy it before you close this dialog."
msgstr "កូនសោនេះត្រូវបានបង្ហាញតែម្តងប៉ុណ្ណោះ។ សូមចម្លងវាមុនពេលអ្នកបិទប្រអប់នេះ។"

#: src/libs/resume/ats.ts
msgid "This link is missing its protocol."
msgstr "តំណនេះបាត់ពិធីការរបស់វា។"

#: src/dialogs/resume/import.tsx
msgid "This may take a few minutes, depending on the response of the AI provider. Please do not close the window or refresh the page."
msgstr "វា​អាច​ចំណាយ​ពេល​ពីរ​នាទី អាស្រ័យ​លើ​ការ​ឆ្លើយតប​របស់​អ្នកផ្តល់​សេវា AI។ សូម​កុំ​បិទ​បង្អួច​នេះ ឬ​ផ្ទុក​ទំព័រ​ឡើង​វិញ។"

#: src/dialogs/resume/import.tsx
msgid "This may take a moment. Please do not close the window or refresh the page."
msgstr "វាអាចចំណាយពេលបន្តិច។ សូម​កុំ​បិទ​វិនដូ ឬ​ទំព័រ​ឡើងវិញ។"

#: src/features/ats-checker/report/report-view.tsx
msgid "This measures how faithfully software can extract this file's text. It does not predict whether an application will be rejected, and no tool can. Your file was read in this browser and never uploaded."
msgstr "នេះវាស់ថាតើកម្មវិធីអាចទាញយកអត្ថបទរបស់ឯកសារនេះបានត្រឹមត្រូវប៉ុណ្ណា។ វាមិនព្យាករណ៍ថាតើពាក្យសុំនឹងត្រូវបានបដិសេធឬអត់នោះទេ ហើយគ្មានឧបករណ៍ណាអាចធ្វើបានដែរ។ ឯកសាររបស់អ្នកត្រូវបានអាននៅក្នុងកម្មវិធីរុករកនេះ ហើយមិនដែលត្រូវបានផ្ទុកឡើងទេ។"

#: src/features/applications/components/calendar-view.tsx
msgid "This month"
msgstr ""

#: src/features/ats-checker/messages.ts
msgid "This page is in columns, and the text extracts out of order."
msgstr "ទំព័រនេះស្ថិតនៅក្នុងជួរឈរ ហើយអត្ថបទត្រូវបានស្រង់ចេញក្រៅលំដាប់។"

#: src/features/ats-checker/messages.ts
msgid "This page is very densely packed."
msgstr "ទំព័រនេះត្រូវបានវេចខ្ចប់យ៉ាងក្រាស់។"

#. Error shown when a PDF has no extractable text layer during import
#: src/dialogs/resume/import.tsx
msgid "This PDF has no readable text. It is likely a scan, so there is nothing to import."
msgstr "PDF នេះមិនមានអត្ថបទដែលអាចអានបានទេ។ វាទំនងជាស្កែន ដូច្នេះមិនមានអ្វីត្រូវនាំចូលទេ។"

#: src/features/ats-checker/tool.tsx
#: src/features/homepage/ats-playground.tsx
msgid "This PDF is password protected. Save an unprotected copy and try again."
msgstr "PDF នេះត្រូវបានការពារដោយពាក្យសម្ងាត់។ រក្សាទុកច្បាប់ចម្លងដែលមិនបានការពារ ហើយសាកល្បងម្តងទៀត។"

#: src/features/homepage/ats-playground.tsx
msgid "This PDF is too large. Choose a file smaller than 25 MB."
msgstr "PDF នេះធំពេក។ ជ្រើសរើសឯកសារដែលតូចជាង 25 MB។"

#: src/libs/resume/ats.ts
msgid "This period ends before it starts."
msgstr "រយៈពេលនេះបញ្ចប់មុនពេលវាចាប់ផ្តើម។"

#: src/libs/resume/ats.ts
msgid "This period starts in the future."
msgstr "រយៈពេលនេះចាប់ផ្តើមនៅពេលអនាគត។"

#: src/features/cover-letters/library.tsx
msgid "This resume has no embedded cover letters."
msgstr "ប្រវត្តិរូបសង្ខេបនេះមិនមានអក្សរគម្របដែលបានបង្កប់ទេ។"

#: src/routes/builder/$resumeId/-sidebar/left/index.tsx
msgid "This resume is locked"
msgstr "ប្រវត្តិរូបសង្ខេបនេះត្រូវបានចាក់សោ"

#: src/features/resume/builder/draft.ts
msgid "This resume is locked and cannot be updated."
msgstr "ប្រវត្តិរូប​នេះ​ត្រូវ​បាន​ចាក់សោ ហើយ​មិន​អាច​បច្ចុប្បន្នភាព​បាន​ទេ។"

#: src/features/ats-checker/messages.ts
msgid "This resume is long."
msgstr "ប្រវត្តិរូបសង្ខេបនេះវែង។"

#: src/features/auth/pages/resume-password.tsx
msgid "This resume is password protected"
msgstr "ប្រវត្តិរូបសង្ខេបនេះត្រូវបានការពារដោយពាក្យសម្ងាត់"

#: src/features/resume/builder/draft.ts
msgid "This resume was updated by an AI agent."
msgstr "ប្រវត្តិរូបសង្ខេបនេះត្រូវបានធ្វើបច្ចុប្បន្នភាពដោយភ្នាក់ងារ AI។"

#: src/features/resume/builder/draft.ts
msgid "This resume's sharing settings changed elsewhere."
msgstr "ការកំណត់​ការចែករំលែក​របស់​ប្រវត្តិរូបសង្ខេប​នេះ​ត្រូវ​បាន​ផ្លាស់ប្តូរ​នៅកន្លែង​ផ្សេង។"

#: src/features/ats-checker/ai-review/ai-review-results.tsx
msgid "This review is a language model's opinion of your writing. It does not change the score above, and it can be wrong. Treat it as a second opinion, not a verdict."
msgstr "ការវាយតម្លៃនេះជាមតិរបស់ម៉ូដែលភាសាចំពោះការសរសេររបស់អ្នក។ វាមិនផ្លាស់ប្តូរពិន្ទុខាងលើទេ ហើយវាអាចខុសបាន។ សូមចាត់ទុកវាជាមតិទីពីរ មិនមែនជាការវិនិច្ឆ័យចុងក្រោយទេ។"

#: src/libs/resume/ats.ts
msgid "This role has no description."
msgstr "តួនាទីនេះមិនមានការពិពណ៌នាទេ។"

#: src/libs/resume/ats.ts
msgid "This section has content but never appears."
msgstr "ផ្នែកនេះមានខ្លឹមសារប៉ុន្តែមិនដែលបង្ហាញទេ។"

#: src/libs/resume/ats.ts
