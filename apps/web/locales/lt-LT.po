msgstr "Pridėkite kelis vaidmenis, kad parodytumėte karjeros augimą toje pačioje įmonėje."

#: src/features/ats-checker/messages.ts
msgid "Add one link that shows your work."
msgstr "Pridėkite bent vieną nuorodą, kuri parodo jūsų darbus."

#: src/features/ats-checker/messages.ts
msgid "Add one with its country code; some application forms require it before you can submit."
msgstr "Pridėkite jį su šalies kodu – kai kurios paraiškų formos jo reikalauja prieš pateikiant."

#: src/routes/builder/$resumeId/-sidebar/right/sections/layout/pages.tsx
msgid "Add Page"
msgstr "Pridėti puslapį"

#: src/features/settings/integrations/components/ai-section.tsx
msgid "Add Provider"
msgstr "Pridėti teikėją"

#: src/dialogs/resume/sections/experience.tsx
msgid "Add Role"
msgstr "Pridėti vaidmenį"

#: src/features/applications/components/calendar-view.tsx
msgid "Add screening calls and technical interviews to see them here and on the calendar."
msgstr ""

#: src/features/ats-checker/messages.ts
msgid "Add some whitespace between sections so a person can skim it."
msgstr "Palikite tarpo tarp skyrių, kad žmogus galėtų greitai peržvelgti tekstą."

#: src/features/applications/components/table-view.tsx
msgid "Add tag"
msgstr "Pridėti žymą"

#: src/features/applications/components/application-form-sheet.tsx
msgid "Add to pipeline"
msgstr "Pridėti į procesą"

#: src/features/ats-checker/messages.ts
msgid "Add two or three lines at the top describing what you do."
msgstr "Viršuje pridėkite dvi ar tris eilutes, aprašančias, ką dirbate."

#: src/libs/resume/ats.ts
msgid "Add your full name under Basics."
msgstr "Skiltyje „Pagrindai“ pridėkite savo vardą ir pavardę."

#: src/routes/agent/-components/agent-chat.tsx
msgid "Adjust the resume for a remote-first role that values async communication and ownership."
msgstr "Koreguokite gyvenimo aprašymą, kad jis atitiktų nuotolinio darbo prioritetą turintį vaidmenį, kuriame vertinamas asinchroninis bendravimas ir atsakomybė."

#: src/features/settings/integrations/components/ai-section.tsx
msgid "Advanced"
msgstr "Išplėstinis"

#: src/features/ats-checker/messages.ts
msgid "Advice for the person reading it. None of this affects the score."
msgstr "Patarimai skaitančiam žmogui. Tai balo neveikia."

