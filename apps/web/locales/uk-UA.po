msgstr "Додати заявку"

#: src/libs/resume/ats.ts
msgid "Add at least a city and country so roles can be matched to your region."
msgstr "Додайте принаймні місто та країну, щоб ролі могли відповідати вашому регіону."

#: src/features/applications/components/application-detail-sheet.tsx
msgid "Add contact"
msgstr "Додати контакт"

#: src/features/ats-checker/messages.ts
msgid "Add figures where you have them: volumes, percentages, timeframes, team sizes."
msgstr "Додайте цифри там, де вони є: обсяги, відсотки, часові рамки, розміри команд."

#: src/components/input/chip-input.tsx
