#: src/features/ats-checker/messages.ts
msgid "Keep it under 2.5 MB, usually by removing or shrinking images."
msgstr "Giữ dung lượng dưới 2.5 MB, thường bằng cách xóa hoặc thu nhỏ hình ảnh."

#: src/routes/builder/$resumeId/-sidebar/right/sections/notes.tsx
