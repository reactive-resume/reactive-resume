#: src/features/ats-checker/messages.ts
msgid "This file is encrypted."
msgstr "ಈ ಫೈಲ್ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file is large for a resume."
msgstr "ಈ ಫೈಲ್ ರೆಸ್ಯೂಮೆಗೆ ದೊಡ್ಡದಾಗಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file is larger than many application forms accept."
msgstr "ಈ ಫೈಲ್ ಅನೇಕ ಅರ್ಜಿ ನಮೂನೆಗಳು ಸ್ವೀಕರಿಸುವುದಕ್ಕಿಂತ ದೊಡ್ಡದಾಗಿದೆ."

#: src/features/resume/editor/write/picture-settings.tsx
msgid "This file isn't a readable image. Choose a PNG, JPEG, WebP or GIF photo."
msgstr "ಈ ಫೈಲ್ ಓದಬಹುದಾದ ಚಿತ್ರವಲ್ಲ. PNG, JPEG, WebP ಅಥವಾ GIF ಫೋಟೋವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ."

#: src/features/documents/import/use-resume-import.ts
msgid "This file type can't be imported. Use a PDF, Word, Reactive Resume or JSON Resume file, or a LinkedIn export (.zip)."
msgstr "ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ಆಮದು ಮಾಡಲಾಗುವುದಿಲ್ಲ. PDF, Word, Reactive Resume ಅಥವಾ JSON Resume ಫೈಲ್ ಅಥವಾ LinkedIn ರಫ್ತು (.zip) ಬಳಸಿ."

#: src/features/ats-checker/messages.ts
msgid "This file uses a lot of different fonts."
msgstr "ಈ ಫೈಲ್ ಹಲವಾರು ವಿಭಿನ್ನ ಫಾಂಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file uses Type 3 fonts, which carry drawings instead of characters."
msgstr "ಈ ಫೈಲ್ Type 3 ಫಾಂಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ, ಇವು ಅಕ್ಷರಗಳ ಬದಲು ಚಿತ್ರಗಳನ್ನು ಹೊಂದಿರುತ್ತವೆ."

#: src/features/documents/import/import-page.tsx
msgid "This file's text couldn't be compared with what came in, so lines left out aren't listed. Check each section against your file in the editor."
msgstr "ಈ ಫೈಲ್‌ನ ಪಠ್ಯವನ್ನು ಬಂದುದರೊಂದಿಗೆ ಹೋಲಿಸಲಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಬಿಟ್ಟ ಸಾಲುಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡಿಲ್ಲ. ಎಡಿಟರ್‌ನಲ್ಲಿ ಪ್ರತಿ ವಿಭಾಗವನ್ನೂ ನಿಮ್ಮ ಫೈಲ್‌ನೊಂದಿಗೆ ಹೋಲಿಸಿ."

#: src/features/career/workspace/practise.tsx
msgid "This interview is unavailable."
msgstr "ಈ ಸಂದರ್ಶನ ಲಭ್ಯವಿಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "This is a PDF Portfolio: the visible page is only a cover."
msgstr "ಇದು PDF ಪೋರ್ಟ್‌ಫೋಲಿಯೊ: ಗೋಚರ ಪುಟ ಕೇವಲ ಮುಖಪುಟ."

#: src/features/ats-checker/messages.ts
msgid "This is an XFA form, so most software reads only the empty shell."
msgstr "ಇದು XFA ಫಾರ್ಮ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ ಹೆಚ್ಚಿನ ಸಾಫ್ಟ್‌ವೇರ್‌ಗಳು ಖಾಲಿ ಚೌಕಟ್ಟನ್ನು ಮಾತ್ರ ಓದುತ್ತವೆ."

#: src/features/ats-checker/messages.ts
msgid "This is not a common resume page size."
msgstr "ಇದು ಸಾಮಾನ್ಯ ರೆಸ್ಯೂಮೆ ಪುಟದ ಗಾತ್ರವಲ್ಲ."

#: src/features/documents/import/use-resume-import.ts
msgid "This JSON isn't a Reactive Resume or JSON Resume file."
msgstr "ಈ JSON Reactive Resume ಅಥವಾ JSON Resume ಫೈಲ್ ಅಲ್ಲ."

#: src/routes/builder/letter/-components/download-sheet.tsx
msgid "This letter and “{resumeName}” as two PDFs, named to match."
msgstr "ಈ ಅಕ್ಷರ ಮತ್ತು \"{resumeName}\" ಎರಡು PDFs, ಹೊಂದಿಕೆಯಾಗುವಂತೆ ಹೆಸರಿಸಲಾಗಿದೆ."

#: src/routes/builder/letter/-components/write-panel.tsx
msgid "This letter changed in another tab. Reload above to keep editing; your edits stay in a copy."
msgstr "ಈ ಲೆಟರ್ ಬೇರೆ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಬದಲಾಗಿದೆ. ಸಂಪಾದನೆ ಮುಂದುವರಿಸಲು ಮೇಲೆ ರೀಲೋಡ್ ಮಾಡಿ; ನಿಮ್ಮ ಸಂಪಾದನೆಗಳು ಒಂದು ನಕಲಲ್ಲಿ ಉಳಿಯುತ್ತವೆ."

#: src/routes/builder/letter/$coverLetterId.tsx
msgid "This letter has an unkept draft. Click Keep to save it, or Discard to leave without it."
msgstr "ಈ ಲೆಟರ್‌ನಲ್ಲಿ ಉಳಿಸದ ಡ್ರಾಫ್ಟ್ ಇದೆ. ಅದನ್ನು ಉಳಿಸಲು “ಇರಿಸಿಕೊಳ್ಳಿ” ಒತ್ತಿ, ಅಥವಾ ಅದರಿಲ್ಲದೆ ಹೋಗಲು “ತೆಗೆದುಹಾಕಿ” ಒತ್ತಿ."

#: src/routes/builder/letter/-components/write-panel.tsx
msgid "This letter is locked."
msgstr ""

#: src/features/documents/document-actions.tsx
msgid "This letter is recorded as sent. Its application link stays with that submission."
msgstr "ಈ ಲೆಟರ್ ಅನ್ನು ಕಳುಹಿಸಿದಂತೆ ದಾಖಲಾಗಿದೆ. ಅದರ ಅರ್ಜಿ ಲಿಂಕ್ ಆ ಸಲ್ಲಿಕೆಯೊಂದಿಗೆಯೇ ಇರುತ್ತದೆ."

#: src/routes/builder/letter/-components/write-panel.tsx
msgid "This letter keeps its recipient as written."
msgstr "ಈ ಪತ್ರವು ಅದರ ಸ್ವೀಕರಿಸುವವರನ್ನು ಬರೆದಂತೆ ಇರಿಸುತ್ತದೆ."

#: src/features/feedback/review-page.tsx
msgid "This link doesn't open"
msgstr "ಈ ಲಿಂಕ್ ತೆರೆಯುವುದಿಲ್ಲ"

#: src/features/feedback/review-page.tsx
msgid "This link has expired"
msgstr "ಈ ಲಿಂಕ್‌ನ ಅವಧಿ ಮುಗಿದಿದೆ"

#. placeholder {0}: view.ownerName
#: src/features/feedback/review-page.tsx
msgid "This link is read-only. Reply to {0} directly with your thoughts."
msgstr "ಈ ಲಿಂಕ್ ಓದಲು-ಮಾತ್ರ. ನಿಮ್ಮ ಅಭಿಪ್ರಾಯಗಳೊಂದಿಗೆ {0} ಅವರಿಗೆ ನೇರವಾಗಿ ಉತ್ತರಿಸಿ."

#: src/features/feedback/review-page.tsx
msgid "This link was turned off"
msgstr "ಈ ಲಿಂಕ್ ಅನ್ನು ಆಫ್ ಮಾಡಲಾಗಿತ್ತು"

#: src/features/keyboard-shortcuts/index.tsx
msgid "This list"
msgstr ""

#: src/features/ats-checker/report/report-view.tsx
msgid "This measures how faithfully software can extract this file's text. It does not predict whether an application will be rejected, and no tool can. Your file was read in this browser and never uploaded."
msgstr "ಈ ಫೈಲ್‌ನ ಪಠ್ಯವನ್ನು ತಂತ್ರಾಂಶ ಎಷ್ಟು ನಿಷ್ಠೆಯಿಂದ ಹೊರತೆಗೆಯಬಲ್ಲದು ಎಂಬುದನ್ನು ಇದು ಅಳೆಯುತ್ತದೆ. ಒಂದು ಅರ್ಜಿ ತಿರಸ್ಕೃತವಾಗುತ್ತದೆಯೇ ಎಂಬುದನ್ನು ಇದು ಊಹಿಸಿ ಹೇಳುವುದಿಲ್ಲ, ಯಾವ ಸಾಧನಕ್ಕೂ ಅದು ಸಾಧ್ಯವಿಲ್ಲ. ನಿಮ್ಮ ಫೈಲ್ ಈ ಬ್ರೌಸರ್‌ನಲ್ಲಿಯೇ ಓದಲ್ಪಟ್ಟಿತು, ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಆಗಲಿಲ್ಲ."

#. placeholder {0}: application.company
#: src/features/applications/components/application-detail-sheet.tsx
msgid "This moves {0} to Applied and saves the versions of the documents you sent."
msgstr ""

#: src/features/career/workspace/fit.tsx
msgid "This needs AI."
msgstr ""

#: src/components/layout/error-screen.tsx
msgid "This page didn't load"
msgstr "ಈ ಪುಟ ಲೋಡ್ ಆಗಲಿಲ್ಲ"

#: src/features/assistant/conversation.tsx
msgid "This page is clipped or incomplete. Check the original before using it."
msgstr "ಈ ಪುಟವನ್ನು ಕ್ಲಿಪ್ ಮಾಡಲಾಗಿದೆ ಅಥವಾ ಅಪೂರ್ಣವಾಗಿದೆ. ಅದನ್ನು ಬಳಸುವ ಮೊದಲು ಮೂಲವನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/features/ats-checker/messages.ts
msgid "This page is in columns, and the text extracts out of order."
msgstr "ಈ ಪುಟ ಕಾಲಮ್‌ಗಳಲ್ಲಿದೆ, ಮತ್ತು ಪಠ್ಯ ಕ್ರಮ ತಪ್ಪಿ ಹೊರತೆಗೆಯಲ್ಪಡುತ್ತದೆ."

#: src/features/ats-checker/messages.ts
msgid "This page is very densely packed."
msgstr "ಈ ಪುಟ ಬಹಳ ದಟ್ಟವಾಗಿ ತುಂಬಿದೆ."

#: src/features/resume/editor/check/parser-view.tsx
msgid "This PDF has no text layer, so a parser reads nothing from it."
msgstr "ಈ PDF ಯಾವುದೇ ಪಠ್ಯ ಪದರವನ್ನು ಹೊಂದಿಲ್ಲ, ಆದ್ದರಿಂದ ಪಾರ್ಸರ್ ಅದರಿಂದ ಏನನ್ನೂ ಓದುವುದಿಲ್ಲ."

#: src/features/resume/import/read-file.ts
msgid "This PDF is a scanned image. There's no text to read. Try the Word version, or start blank and paste sections in."
msgstr "ಈ PDF ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಚಿತ್ರವಾಗಿದೆ. ಓದಲು ಯಾವುದೇ ಪಠ್ಯವಿಲ್ಲ. Word ಆವೃತ್ತಿಯನ್ನು ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಖಾಲಿ ಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ವಿಭಾಗಗಳನ್ನು ಅಂಟಿಸಿ."

#: src/features/applications/components/file-attachment-field.tsx
msgid "This PDF is larger than 10 MB. Compress it or export a smaller PDF, then attach it again."
msgstr "ಈ PDF 10 MB ಗಿಂತ ದೊಡ್ಡದಾಗಿದೆ. ಅದನ್ನು ಸಂಕುಚಿಸಿ ಅಥವಾ ಚಿಕ್ಕ PDF ರಫ್ತು ಮಾಡಿ, ನಂತರ ಮತ್ತೆ ಲಗತ್ ಮಾಡಿ."

#: src/features/ats-checker/checker.tsx
msgid "This PDF is password protected. Save an unprotected copy and try again."
msgstr "ಈ PDF ಪಾಸ್‌ವರ್ಡ್ ಸಂರಕ್ಷಿತವಾಗಿದೆ. ಅಸಂರಕ್ಷಿತ ಪ್ರತಿಯನ್ನು ಉಳಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/features/ats-checker/checker.tsx
msgid "This PDF looks damaged. Export it again from your editor and choose the new file."
msgstr "ಈ PDF ಹಾಳಾಗಿರುವಂತೆ ಕಾಣುತ್ತದೆ. ನಿಮ್ಮ ಎಡಿಟರ್‌ನಿಂದ ಅದನ್ನು ಮತ್ತೆ ರಫ್ತು ಮಾಡಿ, ಹೊಸ ಫೈಲ್ ಆಯ್ಕೆ ಮಾಡಿ."

#: src/features/resume/editor/write/picture-settings.tsx
msgid "This photo is larger than 10 MB. Use Crop and upload to shrink it."
msgstr "ಈ ಫೋಟೋ 10 MB ಗಿಂತ ದೊಡ್ಡದಾಗಿದೆ. ಸಣ್ಣದಾಗಿಸಲು ಕತ್ತರಿಸಿ ಮತ್ತು ಅಪ್‌ಲೋಡ್ ಬಳಸಿ."

#: src/features/assistant/question-card.tsx
msgid "This question couldn't be asked. Send a new message to continue."
msgstr "ಈ ಪ್ರಶ್ನೆಯನ್ನು ಕೇಳಲಾಗಲಿಲ್ಲ. ಮುಂದುವರಿಸಲು ಹೊಸ ಸಂದೇಶ ಕಳುಹಿಸಿ."

#: src/features/assistant/question-card.tsx
msgid "This question didn't finish."
msgstr "ಈ ಪ್ರಶ್ನೆ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ."

#: src/features/settings/profile.tsx
msgid "This removes the saved profile and its references. Career preferences, documents and submitted answers stay unchanged. This cannot be undone."
msgstr "ಇದು ಉಳಿಸಿದ ಪ್ರೊಫೈಲ್ ಮತ್ತು ಅದರ ಪರಿಚಯಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಕೆರಿಯರ್ ಆದ್ಯತೆಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಸಲ್ಲಿಸಿದ ಉತ್ತರಗಳು ಬದಲಾಗದೆ ಇರುತ್ತವೆ. ಇದನ್ನು ರದ್ದು ಮಾಡಲಾಗುವುದಿಲ್ಲ."

#: src/libs/error-message.ts
msgid "This reply couldn't finish. Try again."
msgstr "ಈ ಉತ್ತರ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ಮರುಪ್ರಯತ್ನಿಸಿ."

#: src/features/assistant/conversation.tsx
msgid "This reply used Knowledge that has since changed, so it's hidden."
msgstr "ಈ ಉತ್ತರ ನಂತರ ಬದಲಾದ ಜ್ಞಾನವನ್ನು ಬಳಸಿತ್ತು, ಆದ್ದರಿಂದ ಅದನ್ನು ಮರೆಮಾಡಲಾಗಿದೆ."

#: src/features/auth/pages/forgot-password.tsx
msgid "This reset link expired or was already used, and this server can't send email, so it can't send you a new one."
msgstr ""

#: src/features/auth/error.ts
msgid "This reset link expired or was already used. Send a new link."
msgstr "ಈ ಮರುಹೊಂದಿಸುವ ಲಿಂಕ್ ಅವಧಿ ಮುಗಿದಿದೆ ಅಥವಾ ಈಗಾಗಲೇ ಬಳಸಲಾಗಿದೆ. ಹೊಸ ಲಿಂಕ್ ಕಳುಹಿಸಿ."

#: src/features/auth/pages/forgot-password.tsx
msgid "This reset link expired or was already used. Send yourself a new one."
msgstr ""

