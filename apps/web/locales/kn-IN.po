msgid "The API documentation shows how to connect Reactive Resume to your own applications. It covers the endpoints, the request format, and authentication."
msgstr "Reactive Resume ಅನ್ನು ನಿಮ್ಮದೇ ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ ಹೇಗೆ ಸಂಪರ್ಕಿಸುವುದು ಎಂಬುದನ್ನು API ದಸ್ತಾವೇಜು ತೋರಿಸುತ್ತದೆ. ಇದರಲ್ಲಿ ಎಂಡ್‌ಪಾಯಿಂಟ್‌ಗಳು, ವಿನಂತಿಯ ಸ್ವರೂಪ ಮತ್ತು ದೃಢೀಕರಣ ಸೇರಿವೆ."

#: src/features/settings/pages/api-keys.tsx
msgid "The API key has been deleted."
msgstr "API ಕೀಲಿಯನ್ನು ಅಳಿಸಲಾಗಿದೆ."

#: src/features/auth/pages/error.tsx
msgid "The application that sent you here made an invalid authorization request."
msgstr "ನಿಮ್ಮನ್ನು ಇಲ್ಲಿಗೆ ಕಳುಹಿಸಿದ ಅಪ್ಲಿಕೇಶನ್ ಅಮಾನ್ಯ ಅಧಿಕಾರ ವಿನಂತಿಯನ್ನು ಮಾಡಿದೆ."

#: src/features/ats-checker/ai-review/ai-review-card.tsx
msgid "The checks above are mechanical. This asks a language model what a reader would think of your bullets, and suggests rewrites. It produces no score."
msgstr "ಮೇಲಿನ ಪರಿಶೀಲನೆಗಳು ಯಾಂತ್ರಿಕವಾಗಿವೆ. ಇದು ನಿಮ್ಮ ಬುಲೆಟ್‌ಗಳ ಬಗ್ಗೆ ಓದುಗನ ಅಭಿಪ್ರಾಯವೇನೆಂದು ಭಾಷಾ ಮಾದರಿಯನ್ನು ಕೇಳಿ, ಮರುಬರವಣಿಗೆಯ ಸಲಹೆ ನೀಡುತ್ತದೆ. ಇದು ಯಾವುದೇ ಸ್ಕೋರ್ ನೀಡುವುದಿಲ್ಲ."

#: src/routes/builder/$resumeId/-sidebar/right/sections/ats-check.tsx
msgid "The deep check could not finish. Please try again."
msgstr "ಆಳ ಪರಿಶೀಲನೆ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#. Error shown when AI parsing returns invalid resume structure during import
#: src/dialogs/resume/import.tsx
msgid "The imported file could not be parsed into a valid resume."
msgstr "ಆಮದು ಮಾಡಿದ ಫೈಲ್ ಅನ್ನು ಮಾನ್ಯ ರೆಸ್ಯೂಮ್ ಆಗಿ ಪಾರ್ಸ್ ಮಾಡಲಾಗಲಿಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "The order the text is stored in disagrees badly with the order it reads in."
msgstr "ಪಠ್ಯ ಸಂಗ್ರಹವಾಗಿರುವ ಕ್ರಮವು ಅದು ಓದುವ ಕ್ರಮಕ್ಕೆ ತೀವ್ರವಾಗಿ ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ."

#: src/features/cover-letters/library.tsx
msgid "The original letter stays in your resume. Each copy can be edited independently."
msgstr "ಮೂಲ ಪತ್ರವು ನಿಮ್ಮ ಪುನರಾರಂಭದಲ್ಲಿ ಉಳಿಯುತ್ತದೆ. ಪ್ರತಿಯೊಂದು ಪ್ರತಿಯನ್ನು ಸ್ವತಂತ್ರವಾಗಿ ಸಂಪಾದಿಸಬಹುದು."

#: src/components/layout/not-found-screen.tsx
msgid "The page you're looking for may have been moved or no longer exists."
msgstr "ನೀವು ಹುಡುಕುತ್ತಿರುವ ಪುಟವು ಸ್ಥಳಾಂತರಗೊಂಡಿರಬಹುದು ಅಥವಾ ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲದಿರಬಹುದು."

#: src/features/ats-checker/messages.ts
msgid "The pages are pictures, with no text behind them."
msgstr "ಪುಟಗಳು ಚಿತ್ರಗಳಾಗಿವೆ, ಅವುಗಳ ಹಿಂದೆ ಯಾವುದೇ ಪಠ್ಯವಿಲ್ಲ."

#: src/features/auth/pages/resume-password.tsx
msgid "The password you entered is incorrect"
msgstr "ನೀವು ನಮೂದಿಸಿದ ಪಾಸ್‌ವರ್ಡ್ ಸರಿಯಲ್ಲ"

#: src/routes/_home/ats-checker.tsx
msgid "The PDF is read by code running in this tab. Nothing is uploaded, nothing is stored, and no account is needed. Open your browser's network tab and watch, if you like."
msgstr "ಈ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ ಕೋಡ್ PDF ಅನ್ನು ಓದುತ್ತದೆ. ಏನನ್ನೂ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ, ಏನನ್ನೂ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ, ಮತ್ತು ಯಾವುದೇ ಖಾತೆ ಅಗತ್ಯವಿಲ್ಲ. ಬಯಸಿದರೆ ನಿಮ್ಮ ಬ್ರೌಸರ್‌ನ ನೆಟ್‌ವರ್ಕ್ ಟ್ಯಾಬ್ ತೆರೆದು ಗಮನಿಸಿ."

#: src/features/auth/pages/error.tsx
msgid "The provider didn't share an email address, which is required to sign in."
msgstr "ಪೂರೈಕೆದಾರರು ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಹಂಚಿಕೊಂಡಿಲ್ಲ, ಅದು ಸೈನ್ ಇನ್ ಮಾಡಲು ಅಗತ್ಯವಿದೆ."

#: src/features/auth/pages/error.tsx
msgid "The provider rejected this sign-in attempt. Please start again."
msgstr "ಪೂರೈಕೆದಾರರು ಈ ಸೈನ್-ಇನ್ ಪ್ರಯತ್ನವನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದಾರೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ."

#: src/features/ats-checker/ai-review/ai-review-card.tsx
msgid "The provider returned a review that could not be read. Try again."
msgstr "ಪೂರೈಕೆದಾರರು ಓದಲಾಗದ ವಿಮರ್ಶೆಯನ್ನು ಹಿಂದಿರುಗಿಸಿದ್ದಾರೆ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/features/auth/pages/error.tsx
msgid "The provider's response could not be verified. Please start again."
msgstr "ಪೂರೈಕೆದಾರರ ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ."

#: src/features/homepage/page.tsx
msgid "The rest of your<0/>job search, too."
msgstr "ನಿಮ್ಮ ಉದ್ಯೋಗ ಹುಡುಕಾಟದ<0/>ಉಳಿದ ಭಾಗಕ್ಕೂ."

#: src/features/resume/preview/preview.browser.tsx
msgid "The resume preview could not be updated. The last valid preview is still shown."
msgstr "ರೆಸ್ಯೂಮ್ ಪೂರ್ವವೀಕ್ಷಣೆಯನ್ನು ನವೀಕರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಕೊನೆಯ ಮಾನ್ಯ ಪೂರ್ವವೀಕ್ಷಣೆಯನ್ನು ಇನ್ನೂ ತೋರಿಸಲಾಗಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "The same line repeats on every page."
msgstr "ಅದೇ ಸಾಲು ಪ್ರತಿ ಪುಟದಲ್ಲಿಯೂ ಪುನರಾವರ್ತನೆಯಾಗುತ್ತದೆ."

#. placeholder {0}: getPdfFindingMessage(cap).title
#: src/features/ats-checker/report/score-header.tsx
msgid "The score is capped because of a blocking problem: {0}"
msgstr "ತಡೆಗಟ್ಟುವ ಸಮಸ್ಯೆಯ ಕಾರಣ ಸ್ಕೋರ್ ಅನ್ನು ಮಿತಿಗೊಳಿಸಲಾಗಿದೆ: {0}"

#: src/features/ats-checker/messages.ts
msgid "The text comes out unreadable."
msgstr "ಪಠ್ಯ ಓದಲಾಗದಂತೆ ಹೊರಬರುತ್ತದೆ."

#: src/features/ats-checker/messages.ts
msgid "The top of the first page does not look like a name."
msgstr "ಮೊದಲ ಪುಟದ ಮೇಲ್ಭಾಗ ಹೆಸರಿನಂತೆ ಕಾಣುವುದಿಲ್ಲ."

#: src/components/input/rich-input.tsx
msgid "The URL you entered is not valid."
msgstr "ನೀವು ನಮೂದಿಸಿದ URL ಮಾನ್ಯವಲ್ಲ."

#: src/routes/agent/-components/resume-pane.tsx
msgid "The working resume was deleted. This thread is read-only."
msgstr "ಕೆಲಸದ ರೆಸ್ಯೂಮ್ ಅನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಈ ಥ್ರೆಡ್ ಓದಲು ಮಾತ್ರ."

#. Menu item that opens appearance theme selection submenu
#: src/features/command-palette/pages/preferences/theme.tsx
#: src/features/settings/pages/preferences.tsx
#: src/features/user/dropdown-menu.tsx
msgid "Theme"
msgstr "ಥೀಮ್"

#: src/dialogs/auth/enable-two-factor.tsx
msgid "Then, enter the 6 digit code that the app provides to continue."
msgstr "ನಂತರ, ಆ್ಯಪ್ ನೀಡುವ 6 ಅಂಕಿಯ ಕೋಡ್ ಅನ್ನು ನಮೂದಿಸಿ."

#: src/features/homepage/page.tsx
msgid "There are other ways to pitch in."
msgstr "ಕೈಜೋಡಿಸಲು ಬೇರೆ ದಾರಿಗಳೂ ಇವೆ."

#: src/features/ats-checker/messages.ts
msgid "There is a gap between two dated roles."
msgstr "ಎರಡು ದಿನಾಂಕವುಳ್ಳ ಪಾತ್ರಗಳ ನಡುವೆ ಅಂತರವಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "There is no link to a profile, portfolio or repository."
msgstr "ಪ್ರೊಫೈಲ್, ಪೋರ್ಟ್‌ಫೋಲಿಯೊ ಅಥವಾ ರೆಪೊಸಿಟರಿಗೆ ಯಾವುದೇ ಲಿಂಕ್ ಇಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "There is no summary paragraph."
msgstr "ಯಾವುದೇ ಸಾರಾಂಶ ಪ್ಯಾರಾಗ್ರಾಫ್ ಇಲ್ಲ."

#: src/routes/builder/$resumeId/-sidebar/right/sections/ats-check.tsx
msgid "These checks run as you type and never leave your browser. They test whether software can read your resume, not how well it is written."
msgstr "ನೀವು ಟೈಪ್ ಮಾಡುತ್ತಿರುವಾಗಲೇ ಈ ಪರಿಶೀಲನೆಗಳು ನಡೆಯುತ್ತವೆ ಮತ್ತು ಅವು ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ಎಂದಿಗೂ ಬಿಟ್ಟು ಹೋಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ರೆಸ್ಯೂಮ್ ಅನ್ನು ತಂತ್ರಾಂಶ ಓದಬಲ್ಲದೇ ಎಂಬುದನ್ನಷ್ಟೇ ಅವು ಪರೀಕ್ಷಿಸುತ್ತವೆ, ಅದು ಎಷ್ಟು ಚೆನ್ನಾಗಿ ಬರೆದಿದೆ ಎಂಬುದನ್ನಲ್ಲ."

#: src/libs/resume/ats.ts
msgid "These dates will not be read correctly."
msgstr "ಈ ದಿನಾಂಕಗಳನ್ನು ಸರಿಯಾಗಿ ಓದಲಾಗುವುದಿಲ್ಲ."

#: src/routes/agent/-components/agent-chat.tsx
msgid "Thinking"
msgstr "ಆಲೋಚನೆ"

#: src/routes/builder/$resumeId/-components/header.tsx
#: src/routes/dashboard/resumes/-components/menus/use-resume-menu-actions.ts
msgid "This action cannot be undone."
msgstr "ಈ ಕ್ರಿಯೆಯನ್ನು ಹಿಂತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ."

#: src/features/settings/pages/account.tsx
msgid "This action cannot be undone. All your data will be permanently deleted."
msgstr "ಈ ಕ್ರಿಯೆಯನ್ನು ಹಿಂತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗುತ್ತದೆ."

#: src/routes/agent/-components/thread-sidebar.tsx
msgid "This action cannot be undone. It deletes the thread's messages and uploaded attachments."
msgstr "ಈ ಕ್ರಿಯೆಯನ್ನು ಹಿಂತಿರುಗಿಸಲಾಗದು. ಇದು ಥ್ರೆಡ್‌ನ ಸಂದೇಶಗಳನ್ನು ಮತ್ತು ಅಪ್‌ಲೋಡ್ ಮಾಡಿದ ಲಗತ್ತುಗಳನ್ನು ಅಳಿಸುತ್ತದೆ."

#: src/routes/agent/-components/agent-chat.tsx
msgid "This action cannot be undone. It deletes the thread's messages and uploaded attachments. The working resume stays in your dashboard, and you can delete it separately."
msgstr "ಈ ಕ್ರಿಯೆಯನ್ನು ಹಿಂತಿರುಗಿಸಲಾಗದು. ಇದು ಥ್ರೆಡ್‌ನ ಸಂದೇಶಗಳನ್ನು ಮತ್ತು ಅಪ್‌ಲೋಡ್ ಮಾಡಿದ ಲಗತ್ತುಗಳನ್ನು ಅಳಿಸುತ್ತದೆ. ಕೆಲಸ ನಡೆಯುತ್ತಿರುವ ರೆಸ್ಯೂಮ್ ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿಯೇ ಉಳಿಯುತ್ತದೆ, ಅದನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಅಳಿಸಬಹುದು."

#: src/routes/builder/$resumeId/-components/ai-assistant.tsx
msgid "This assistant could not be opened."
msgstr "ಈ ಸಹಾಯಕವನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#: src/features/auth/pages/consent.tsx
msgid "This connection request is invalid or has expired."
msgstr "ಈ ಸಂಪರ್ಕ ವಿನಂತಿಯು ಅಮಾನ್ಯವಾಗಿದೆ ಅಥವಾ ಅವಧಿ ಮೀರಿದೆ."

#: src/features/cover-letters/editor.tsx
msgid "This cover letter changed elsewhere. Your edits are still here. Reload the latest version before saving again."
msgstr "ಈ ಕವರ್ ಲೆಟರ್ ಬೇರೆಡೆ ಬದಲಾಗಿದೆ. ನಿಮ್ಮ ಸಂಪಾದನೆಗಳು ಇನ್ನೂ ಇಲ್ಲಿವೆ. ಮತ್ತೆ ಉಳಿಸುವ ಮೊದಲು ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಿ."

#: src/dialogs/api-key/create.tsx
msgid "This creates a new API key, which lets other programs read and change your resume data through the Reactive Resume API."
msgstr "ಇದು ಹೊಸ API ಕೀಲಿಯನ್ನು ರಚಿಸುತ್ತದೆ; Reactive Resume API ಮೂಲಕ ನಿಮ್ಮ ರೆಸ್ಯೂಮ್ ಡೇಟಾವನ್ನು ಓದಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಇದು ಇತರ ಪ್ರೋಗ್ರಾಂಗಳಿಗೆ ಅವಕಾಶ ನೀಡುತ್ತದೆ."

#: src/libs/resume/ats.ts
msgid "This date will not be read correctly."
msgstr "ಈ ದಿನಾಂಕವನ್ನು ಸರಿಯಾಗಿ ಓದಲಾಗುವುದಿಲ್ಲ."

#: src/routes/agent/-components/patch-approval-card.tsx
msgid "This edit request can no longer be answered."
msgstr "ಈ ಸಂಪಾದನೆ ವಿನಂತಿಗೆ ಇನ್ನು ಮುಂದೆ ಉತ್ತರಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: src/libs/resume/ats.ts
msgid "This email address will not be recognized."
msgstr "ಈ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಗುರುತಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/libs/resume/ats.ts
msgid "This entry has no dates."
msgstr "ಈ ನಮೂದು ಯಾವುದೇ ದಿನಾಂಕಗಳನ್ನು ಹೊಂದಿಲ್ಲ."

#: src/features/applications/components/application-detail-sheet.tsx
msgid "This entry will be permanently deleted. This can't be undone."
msgstr "ಈ ನಮೂದನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ಹಿಂದಿರುಗಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/dialogs/resume/import.tsx
msgid "This feature requires a connected AI provider. Please set one up in the settings."
msgstr "ಈ ವೈಶಿಷ್ಟ್ಯಕ್ಕೆ ಸಂಪರ್ಕಿತ AI ಪೂರೈಕೆದಾರರ ಅಗತ್ಯವಿದೆ. ದಯವಿಟ್ಟು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಒಂದನ್ನು ಹೊಂದಿಸಿ."

#: src/features/ats-checker/messages.ts
msgid "This file contains form fields."
msgstr "ಈ ಫೈಲ್ ಫಾರ್ಮ್ ಕ್ಷೇತ್ರಗಳನ್ನು ಒಳಗೊಂಡಿದೆ."

#: src/features/ats-checker/report/jd-coverage.tsx
msgid "This file contains text a reader cannot see, so some of these matches may be against it."
msgstr "ಈ ಫೈಲ್ ಓದುಗನಿಗೆ ಕಾಣದ ಪಠ್ಯವನ್ನು ಒಳಗೊಂಡಿದೆ, ಆದ್ದರಿಂದ ಈ ಹೊಂದಾಣಿಕೆಗಳಲ್ಲಿ ಕೆಲವು ಅದರ ವಿರುದ್ಧ ಇರಬಹುದು."

#: src/features/ats-checker/messages.ts
msgid "This file contains text drawn invisibly."
msgstr "ಈ ಫೈಲ್ ಅದೃಶ್ಯವಾಗಿ ಬಿಡಿಸಿದ ಪಠ್ಯವನ್ನು ಒಳಗೊಂಡಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file contains white-on-white text."
msgstr "ಈ ಫೈಲ್ ಬಿಳಿ-ಮೇಲೆ-ಬಿಳಿ ಪಠ್ಯವನ್ನು ಒಳಗೊಂಡಿದೆ."

#: src/features/homepage/ats-playground.tsx
msgid "This file could not be read as a PDF. Export a new copy and try again."
msgstr "ಈ ಫೈಲ್ ಅನ್ನು PDF ಆಗಿ ಓದಲಾಗಲಿಲ್ಲ. ಹೊಸ ಪ್ರತಿಯನ್ನು ರಫ್ತು ಮಾಡಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/features/ats-checker/messages.ts
msgid "This file declares no language."
msgstr "ಈ ಫೈಲ್ ಯಾವುದೇ ಭಾಷೆಯನ್ನು ಘೋಷಿಸುವುದಿಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "This file has no accessibility tags."
msgstr "ಈ ಫೈಲ್‌ನಲ್ಲಿ ಯಾವುದೇ ಪ್ರವೇಶಸಾಧ್ಯತಾ ಟ್ಯಾಗ್‌ಗಳಿಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "This file is encrypted."
msgstr "ಈ ಫೈಲ್ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file is large for a resume."
msgstr "ಈ ಫೈಲ್ ರೆಸ್ಯೂಮೆಗೆ ದೊಡ್ಡದಾಗಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file is larger than many application forms accept."
msgstr "ಈ ಫೈಲ್ ಅನೇಕ ಅರ್ಜಿ ನಮೂನೆಗಳು ಸ್ವೀಕರಿಸುವುದಕ್ಕಿಂತ ದೊಡ್ಡದಾಗಿದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file uses a lot of different fonts."
msgstr "ಈ ಫೈಲ್ ಹಲವಾರು ವಿಭಿನ್ನ ಫಾಂಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ."

#: src/features/ats-checker/messages.ts
msgid "This file uses Type 3 fonts, which carry drawings instead of characters."
msgstr "ಈ ಫೈಲ್ Type 3 ಫಾಂಟ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ, ಇವು ಅಕ್ಷರಗಳ ಬದಲು ಚಿತ್ರಗಳನ್ನು ಹೊಂದಿರುತ್ತವೆ."

#: src/libs/resume/ats.ts
msgid "This heading is not one parsers look for."
msgstr "ಈ ಶಿರೋನಾಮೆ ಒಂದು ಪಾರ್ಸರ್‌ಗಳು ಹುಡುಕುತ್ತಿಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "This is a PDF Portfolio: the visible page is only a cover."
msgstr "ಇದು PDF ಪೋರ್ಟ್‌ಫೋಲಿಯೊ: ಗೋಚರ ಪುಟ ಕೇವಲ ಮುಖಪುಟ."

#: src/features/homepage/feature-explorer.tsx
msgid "This is a sample edit. In the app, connect your own AI provider. Turn on Review edits to approve changes before they’re applied."
msgstr "ಇದು ಮಾದರಿ ಸಂಪಾದನೆ. ಆ್ಯಪ್‌ನಲ್ಲಿ ನಿಮ್ಮದೇ AI ಪೂರೈಕೆದಾರರನ್ನು ಸಂಪರ್ಕಿಸಿ. ಬದಲಾವಣೆಗಳು ಅನ್ವಯವಾಗುವ ಮೊದಲು ಅವುಗಳನ್ನು ಅನುಮೋದಿಸಲು “ಸಂಪಾದನೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ” ಆನ್ ಮಾಡಿ."

#: src/dialogs/resume/index.tsx
msgid "This is a URL-friendly name for your resume."
msgstr "ಇದು ನಿಮ್ಮ ರೆಸ್ಯೂಮ್‌ಗಾಗಿ URL ಗೆ ಅನುಕೂಲಕರವಾದ ಹೆಸರು."

#: src/features/ats-checker/messages.ts
msgid "This is an XFA form, so most software reads only the empty shell."
msgstr "ಇದು XFA ಫಾರ್ಮ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ ಹೆಚ್ಚಿನ ಸಾಫ್ಟ್‌ವೇರ್‌ಗಳು ಖಾಲಿ ಚೌಕಟ್ಟನ್ನು ಮಾತ್ರ ಓದುತ್ತವೆ."

#: src/features/ats-checker/messages.ts
msgid "This is not a common resume page size."
msgstr "ಇದು ಸಾಮಾನ್ಯ ರೆಸ್ಯೂಮೆ ಪುಟದ ಗಾತ್ರವಲ್ಲ."

#: src/dialogs/api-key/create.tsx
msgid "This key is shown only once. Copy it before you close this dialog."
msgstr "ಈ ಕೀಲಿ ಒಂದೇ ಬಾರಿ ಮಾತ್ರ ತೋರಿಸಲಾಗುತ್ತದೆ. ಈ ಸಂವಾದವನ್ನು ಮುಚ್ಚುವ ಮೊದಲು ಅದನ್ನು ನಕಲಿಸಿಕೊಳ್ಳಿ."

#: src/libs/resume/ats.ts
msgid "This link is missing its protocol."
msgstr "ಈ ಲಿಂಕ್ ತನ್ನ ಪ್ರೋಟೋಕಾಲ್ ಅನ್ನು ಕಳೆದುಕೊಂಡಿದೆ."

#: src/dialogs/resume/import.tsx
msgid "This may take a few minutes, depending on the response of the AI provider. Please do not close the window or refresh the page."
msgstr "ಇದು AI ಪ್ರೊವೈಡರ್‌ನ ಪ್ರತಿಕ್ರಿಯೆಯ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿ ಕೆಲ ನಿಮಿಷಗಳು ತೆಗೆದುಕೊಳ್ಳಬಹುದು. ದಯವಿಟ್ಟು ವಿಂಡೋ ಅನ್ನು ಮುಚ್ಚಬೇಡಿ ಅಥವಾ ಪುಟವನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಬೇಡಿ."

#: src/dialogs/resume/import.tsx
msgid "This may take a moment. Please do not close the window or refresh the page."
msgstr "ಇದು ಸ್ವಲ್ಪ ಸಮಯ ತೆಗೆದುಕೊಳ್ಳಬಹುದು. ದಯವಿಟ್ಟು ವಿಂಡೋವನ್ನು ಮುಚ್ಚಬೇಡಿ ಅಥವಾ ಪುಟವನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಬೇಡಿ."

#: src/features/ats-checker/report/report-view.tsx
msgid "This measures how faithfully software can extract this file's text. It does not predict whether an application will be rejected, and no tool can. Your file was read in this browser and never uploaded."
msgstr "ಈ ಫೈಲ್‌ನ ಪಠ್ಯವನ್ನು ತಂತ್ರಾಂಶ ಎಷ್ಟು ನಿಷ್ಠೆಯಿಂದ ಹೊರತೆಗೆಯಬಲ್ಲದು ಎಂಬುದನ್ನು ಇದು ಅಳೆಯುತ್ತದೆ. ಒಂದು ಅರ್ಜಿ ತಿರಸ್ಕೃತವಾಗುತ್ತದೆಯೇ ಎಂಬುದನ್ನು ಇದು ಊಹಿಸಿ ಹೇಳುವುದಿಲ್ಲ, ಯಾವ ಸಾಧನಕ್ಕೂ ಅದು ಸಾಧ್ಯವಿಲ್ಲ. ನಿಮ್ಮ ಫೈಲ್ ಈ ಬ್ರೌಸರ್‌ನಲ್ಲಿಯೇ ಓದಲ್ಪಟ್ಟಿತು, ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಆಗಲಿಲ್ಲ."

#: src/features/applications/components/calendar-view.tsx
msgid "This month"
msgstr ""

#: src/features/ats-checker/messages.ts
msgid "This page is in columns, and the text extracts out of order."
msgstr "ಈ ಪುಟ ಕಾಲಮ್‌ಗಳಲ್ಲಿದೆ, ಮತ್ತು ಪಠ್ಯ ಕ್ರಮ ತಪ್ಪಿ ಹೊರತೆಗೆಯಲ್ಪಡುತ್ತದೆ."

#: src/features/ats-checker/messages.ts
msgid "This page is very densely packed."
msgstr "ಈ ಪುಟ ಬಹಳ ದಟ್ಟವಾಗಿ ತುಂಬಿದೆ."

#. Error shown when a PDF has no extractable text layer during import
#: src/dialogs/resume/import.tsx
msgid "This PDF has no readable text. It is likely a scan, so there is nothing to import."
msgstr "ಈ PDF ಯಾವುದೇ ಓದಬಲ್ಲ ಪಠ್ಯವನ್ನು ಹೊಂದಿಲ್ಲ. ಇದು ಸ್ಕ್ಯಾನ್ ಆಗಿರಬಹುದು, ಆದ್ದರಿಂದ ಆಮದು ಮಾಡಿಕೊಳ್ಳಲು ಏನೂ ಇಲ್ಲ."

#: src/features/ats-checker/tool.tsx
#: src/features/homepage/ats-playground.tsx
msgid "This PDF is password protected. Save an unprotected copy and try again."
msgstr "ಈ PDF ಪಾಸ್‌ವರ್ಡ್ ಸಂರಕ್ಷಿತವಾಗಿದೆ. ಅಸಂರಕ್ಷಿತ ಪ್ರತಿಯನ್ನು ಉಳಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: src/features/homepage/ats-playground.tsx
msgid "This PDF is too large. Choose a file smaller than 25 MB."
msgstr "ಈ PDF ತುಂಬಾ ದೊಡ್ಡದು. 25 MB ಗಿಂತ ಚಿಕ್ಕ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ."

#: src/libs/resume/ats.ts
msgid "This period ends before it starts."
msgstr "ಈ ಅವಧಿಯು ಪ್ರಾರಂಭವಾಗುವ ಮೊದಲು ಕೊನೆಗೊಳ್ಳುತ್ತದೆ."

#: src/libs/resume/ats.ts
msgid "This period starts in the future."
msgstr "ಈ ಅವಧಿಯು ಭವಿಷ್ಯದಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

#: src/features/cover-letters/library.tsx
msgid "This resume has no embedded cover letters."
msgstr "ಈ ಪುನರಾರಂಭವು ಎಂಬೆಡೆಡ್ ಕವರ್ ಲೆಟರ್‌ಗಳನ್ನು ಹೊಂದಿಲ್ಲ."

#: src/routes/builder/$resumeId/-sidebar/left/index.tsx
msgid "This resume is locked"
msgstr "ಈ ರೆಸ್ಯೂಮ್ ಲಾಕ್ ಆಗಿದೆ."

#: src/features/resume/builder/draft.ts
msgid "This resume is locked and cannot be updated."
msgstr "ಈ ರೆಸ್ಯೂಮ್ ಲಾಕ್ ಆಗಿದೆ ಮತ್ತು ಅದನ್ನು ನವೀಕರಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: src/features/ats-checker/messages.ts
msgid "This resume is long."
msgstr "ಈ ರೆಸ್ಯೂಮೆ ಉದ್ದವಾಗಿದೆ."

#: src/features/auth/pages/resume-password.tsx
msgid "This resume is password protected"
msgstr "ಈ ರೆಸ್ಯೂಮ್ ಪಾಸ್‌ವರ್ಡ್‌ನಿಂದ ರಕ್ಷಿತವಾಗಿದೆ"

#: src/features/resume/builder/draft.ts
msgid "This resume was updated by an AI agent."
msgstr "ಈ ರೆಸ್ಯೂಮ್ ಅನ್ನು AI ಏಜೆಂಟ್ ನವೀಕರಿಸಿದ್ದಾರೆ."

#: src/features/resume/builder/draft.ts
msgid "This resume's sharing settings changed elsewhere."
msgstr "ಈ ರೆಸ್ಯೂಮ್‌ನ ಹಂಚಿಕೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಬೇರೆಡೆ ಬದಲಾಗಿವೆ."

#: src/features/ats-checker/ai-review/ai-review-results.tsx
msgid "This review is a language model's opinion of your writing. It does not change the score above, and it can be wrong. Treat it as a second opinion, not a verdict."
msgstr "ಈ ವಿಮರ್ಶೆ ನಿಮ್ಮ ಬರವಣಿಗೆಯ ಬಗ್ಗೆ ಒಂದು ಭಾಷಾ ಮಾದರಿಯ ಅಭಿಪ್ರಾಯ. ಇದು ಮೇಲಿನ ಅಂಕವನ್ನು ಬದಲಾಯಿಸುವುದಿಲ್ಲ, ಮತ್ತು ಇದು ತಪ್ಪೂ ಆಗಿರಬಹುದು. ಇದನ್ನು ಅಂತಿಮ ತೀರ್ಪಾಗಿ ಅಲ್ಲ, ಎರಡನೇ ಅಭಿಪ್ರಾಯವಾಗಿ ಪರಿಗಣಿಸಿ."

#: src/libs/resume/ats.ts
msgid "This role has no description."
msgstr "ಈ ಪಾತ್ರಕ್ಕೆ ಯಾವುದೇ ವಿವರಣೆ ಇಲ್ಲ."

#: src/libs/resume/ats.ts
msgid "This section has content but never appears."
msgstr "ಈ ವಿಭಾಗವು ವಿಷಯವನ್ನು ಹೊಂದಿದೆ ಆದರೆ ಎಂದಿಗೂ ಕಾಣಿಸುವುದಿಲ್ಲ."

#: src/libs/resume/ats.ts
msgid "This section is split across columns."
msgstr "ಈ ವಿಭಾಗವನ್ನು ಕಾಲಮ್‌ಗಳಲ್ಲಿ ವಿಭಜಿಸಲಾಗಿದೆ."

#: src/libs/resume/ats.ts
msgid "This section sits in the sidebar."
msgstr "ಈ ವಿಭಾಗವು ಸೈಡ್‌ಬಾರ್‌ನಲ್ಲಿ ಇರುತ್ತದೆ."

#: src/features/auth/pages/error.tsx
msgid "This sign-in attempt expired or was already used. Please start again."
msgstr "ಈ ಸೈನ್-ಇನ್ ಪ್ರಯತ್ನ ಅವಧಿ ಮುಗಿದಿದೆ ಅಥವಾ ಈಗಾಗಲೇ ಬಳಸಲಾಗಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ."

#: src/features/auth/pages/register.tsx
msgid "This step is optional, but recommended."
msgstr "ಈ ಹಂತ ಐಚ್ಛಿಕ, ಆದರೆ ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ."

#: src/routes/agent/-components/agent-chat.tsx
