#: src/dialogs/resume/template/data.ts
msgid "Single-column ruled form inspired by the Japanese rirekisho: a bordered header of field cells and every section as a table with a solid title bar; dense and fast to scan for engineering, operations, or applications in Japan."
msgstr "Jednostĺpcový formulár inšpirovaný japonským životopisom rirekisho: hlavička z ohraničených polí a každá sekcia ako tabuľka s plným záhlavím. Kompaktný a rýchlo prehľadný, vhodný pre inžinierske a prevádzkové pozície alebo žiadosti o prácu v Japonsku."

#: src/dialogs/resume/template/data.ts
msgid "Single-column set like a magazine feature: a large display name under an uppercase kicker and the summary as a larger standfirst; refined for writers, designers, and communications roles."
msgstr "Jeden stĺpec zalomený ako článok v časopise: veľké meno pod nadtitulkom z veľkých písmen a zhrnutie ako väčší perex; vyladený pre autorov, dizajnérov a pozície v komunikácii."

#: src/dialogs/resume/template/data.ts
msgid "Single-column Wall Street style with a centered header and ruled section headings."
msgstr "Jednostĺpcový štýl Wall Street s vycentrovaným záhlavím a nadpismi sekcií oddelenými čiarami."

#: src/dialogs/resume/template/data.ts
msgid "Single-column with a magenta left border accent; compact and efficient for entry-level or internship applications."
msgstr "Jednostĺpcové rozloženie s purpurovým zvýraznením ľavého okraja; kompaktné a efektívne pre juniorské alebo stážistické pozície."

#: src/dialogs/resume/template/data.ts
msgid "Single-column with a minimal top header and lots of whitespace; clean and modern for designers or content creators."
msgstr "Jednostĺpcové rozloženie s minimalistickou hornou hlavičkou a množstvom voľného miesta; čisté a moderné pre dizajnérov alebo tvorcov obsahu."

#: src/dialogs/resume/template/data.ts
msgid "Single-column with uppercase section headings and a primary-color top rule on every page; polished for executive, consulting, or startup resumes."
msgstr "Jednostĺpcový s veľkými písmenami v nadpisoch sekcií a hornou čiarou v základnej farbe na každej strane; vylepšené pre životopisy manažérov, konzultantov alebo startupov."

#: src/dialogs/resume/template/data.ts
msgid "Single-column with uppercase section headings over a rule and the photo beside the name; compact and ATS-friendly, well-suited for Asian resume conventions (CN/JP/KR)."
msgstr "Jeden stĺpec s nadpismi sekcií veľkými písmenami nad čiarou a fotografiou vedľa mena; kompaktné rozloženie vhodné pre ATS aj ázijské zvyklosti životopisov (CN/JP/KR)."

#: src/dialogs/resume/template/data.ts
msgid "Single-column; polished and serious for senior or enterprise-level positions."
msgstr "Jednostĺpcové rozloženie; uhladené a seriózne pre seniorské alebo enterprise pozície."

