#: src/features/resume/editor/check/job-match.tsx
msgid "The posting asks for “{label}”. If it's true for me, work it into my resume where it fits. Ask me first."
msgstr "வேலை இடுகை \"{label}\" என்று கேட்கிறது. இது எனக்கு உண்மையாக இருந்தால், அது பொருந்தும் இடத்தில் எனது ரெஸ்யூமில் வேலை செய்யவும். முதலில் என்னிடம் கேள்."

#: src/features/applications/components/add-application-dialog.tsx
msgid "The posting couldn't be read. Fill in the role and company."
msgstr "வேலை இடுகையைப் படிக்க முடியவில்லை. பங்கு மற்றும் நிறுவனத்தை நிரப்பவும்."

#: src/features/applications/components/application-detail-sheet.tsx
msgid "The posting saved with this application."
msgstr "இந்த வேலை விண்ணப்பத்துடன் வேலை இடுகை சேமிக்கப்பட்டது."

#: src/features/settings/ai/providers.tsx
