#: src/features/documents/new-document-dialog.tsx
msgid "This file type can't be imported. Use a PDF, Word, Reactive Resume or JSON Resume file, or a LinkedIn export (.zip)."
msgstr "ഈ ഫയൽ തരം ഇറക്കുമതി ചെയ്യാൻ കഴിയില്ല. ഒരു PDF, Word, Reactive Resume അല്ലെങ്കിൽ JSON Resume ഫയൽ അല്ലെങ്കിൽ LinkedIn കയറ്റുമതി (.zip) ഉപയോഗിക്കുക."

#: src/features/ats-checker/messages.ts
msgid "This file uses a lot of different fonts."
msgstr "ഈ ഫയൽ ധാരാളം വ്യത്യസ്ത ഫോണ്ടുകൾ ഉപയോഗിക്കുന്നു."

#: src/features/ats-checker/messages.ts
msgid "This file uses Type 3 fonts, which carry drawings instead of characters."
msgstr "ഈ ഫയൽ Type 3 ഫോണ്ടുകൾ ഉപയോഗിക്കുന്നു, അവ അക്ഷരങ്ങൾക്ക് പകരം ഡ്രോയിംഗുകൾ വഹിക്കുന്നു."

#: src/features/ats-checker/messages.ts
msgid "This is a PDF Portfolio: the visible page is only a cover."
msgstr "ഇത് ഒരു PDF പോർട്ട്‌ഫോളിയോ ആണ്: ദൃശ്യമായ പേജ് ഒരു കവർ മാത്രമാണ്."

#: src/features/ats-checker/messages.ts
msgid "This is an XFA form, so most software reads only the empty shell."
msgstr "ഇത് ഒരു XFA ഫോം ആണ്, അതിനാൽ മിക്ക സോഫ്റ്റ്‌വെയറും ശൂന്യമായ ഷെൽ മാത്രമേ വായിക്കൂ."

#: src/features/ats-checker/messages.ts
msgid "This is not a common resume page size."
