#: src/libs/resume/ats.ts
msgid "Your resume has no phone number."
msgstr "നിങ്ങളുടെ റെസ്യൂമിന് ഫോൺ നമ്പറില്ല."

#: src/libs/resume/ats.ts
msgid "Your resume includes a photo."
msgstr "നിങ്ങളുടെ റെസ്യൂമിൽ ഒരു ഫോട്ടോ ഉൾപ്പെടുന്നു."

#: src/features/homepage/feature-explorer.tsx
msgid "Your resume link"
msgstr "നിങ്ങളുടെ റെസ്യൂമെ ലിങ്ക്"

#: src/libs/resume/ats.ts
msgid "Your resume shows no work experience."
msgstr "നിങ്ങളുടെ ബയോഡാറ്റ ഒരു പ്രവൃത്തി പരിചയവും കാണിക്കുന്നില്ല."

#: src/features/ats-checker/messages.ts
msgid "Your resume uses \"I\" and \"my\"."
msgstr "നിങ്ങളുടെ റിസ്യൂം \"I\", \"my\" എന്നിവ ഉപയോഗിക്കുന്നു."

#: src/routes/builder/$resumeId/-sidebar/right/sections/sharing.tsx
msgid "Your resume's public URL is protected by a password. Share the password only with people you trust."
msgstr "നിങ്ങളുടെ റിസ്യൂമിന്റെ പൊതു URL ഒരു പാസ്‌വേഡ് കൊണ്ട് സംരക്ഷിച്ചിരിക്കുന്നു. നിങ്ങൾ വിശ്വസിക്കുന്നവരുമായി മാത്രം പാസ്‌വേഡ് പങ്കിടുക."

#: src/features/cover-letters/editor-dialog.tsx
msgid "Your saved cover letter will remain unchanged."
msgstr "നിങ്ങളുടെ സംരക്ഷിച്ച കവർ ലെറ്റർ മാറ്റമില്ലാതെ തുടരും."

#: src/features/homepage/ats-playground.tsx
msgid "Your selected file"
msgstr "നിങ്ങൾ തിരഞ്ഞെടുത്ത ഫയൽ"

#: src/features/homepage/feature-explorer.tsx
msgid "Your tools, connected"
msgstr "നിങ്ങളുടെ ഉപകരണങ്ങൾ, ബന്ധിപ്പിച്ചിരിക്കുന്നു"

#: src/features/homepage/export-playground.tsx
msgid "Your words as a plain-text document, with headings, lists, and links."
msgstr "തലക്കെട്ടുകളും പട്ടികകളും ലിങ്കുകളുമുള്ള ഒരു പ്ലെയിൻ-ടെക്സ്റ്റ് രേഖയായി നിങ്ങളുടെ വാക്കുകൾ."

