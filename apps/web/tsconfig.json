{
	"extends": "@reactive-resume/config/tsconfig.base.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "@testing-library/jest-dom/vitest"],

		"noEmit": true,
