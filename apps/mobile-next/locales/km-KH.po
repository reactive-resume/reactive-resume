msgstr "កូនសោត្រូវបានបដិសេធ។ ពិនិត្យកូនសោ ហើយសាកល្បងម្ដងទៀត។"

#: src/features/builder/description/DescriptionScreen.tsx
msgid "The line changed since you asked, so it wasn't replaced."
msgstr "បន្ទាត់បានផ្លាស់ប្តូរចាប់តាំងពីអ្នកបានសួរ ដូច្នេះវាមិនត្រូវបានជំនួសទេ។"

#: src/features/workspace/Recorder.tsx
msgid "The microphone is off for Reactive Resume. Type your answer, or turn it on in Settings."
msgstr "មីក្រូហ្វូនសម្រាប់ Reactive Resume បិទ។ វាយចម្លើយ ឬបើកក្នុងការកំណត់។"

#: src/features/settings/providers.ts
msgid "The model wasn't available or couldn't complete the test. Check its name or try another model."
msgstr "ម៉ូដែលមិនអាចប្រើបាន ឬមិនអាចបញ្ចប់ការសាកល្បងបានទេ។ ពិនិត្យឈ្មោះរបស់វា ឬសាកល្បងម៉ូដែលផ្សេង។"

#: src/features/public/ats-messages.ts
msgid "The order the text is stored in disagrees badly with the order it reads in."
msgstr "លំដាប់ដែលអត្ថបទត្រូវបានផ្ទុកខុសគ្នាយ៉ាងខ្លាំងពីលំដាប់ដែលវាអាន។"

#: src/features/public/ats-messages.ts
msgid "The pages are pictures, with no text behind them."
msgstr "ទំព័រទាំងនោះជារូបភាព ដោយគ្មានអត្ថបទនៅពីក្រោយវាទេ។"

#: src/api/ai-consent.ts
msgid "The posting text or retrieved page. Links also go to the reader and the site being read."
msgstr "អត្ថបទប្រកាសការងារ ឬទំព័រដែលបានទាញយក។ តំណក៏ទៅកាន់កម្មវិធីអាន និងគេហទំព័រដែលកំពុងត្រូវបានអានដែរ។"

#: src/features/builder/design/LayoutScreen.tsx
msgid "The preview took too long to update, so Fit stopped."
msgstr "ការមើលជាមុនធ្វើបច្ចុប្បន្នភាពយូរពេក ដូច្នេះការបង្រួមទំព័របានឈប់។"

#: src/features/settings/providers.ts
msgid "The provider limited this request. Wait and try again; check your account quota."
msgstr "អ្នកផ្តល់សេវាបានកំណត់សំណើនេះ។ រង់ចាំ ហើយព្យាយាមម្ដងទៀត; ពិនិត្យកូតាគណនីរបស់អ្នក។"

#: src/features/settings/providers.ts
msgid "The provider reported a server error. Try again later."
msgstr "អ្នកផ្តល់សេវាបានរាយការណ៍ពីកំហុសម៉ាស៊ីនមេ។ ព្យាយាមម្ដងទៀតពេលក្រោយ។"

#: src/features/builder/versions/versions-screen.tsx
msgid "The resume as it is"
msgstr "ប្រវត្តិរូប​ដូច​ជា​"

#: src/features/public/ats-messages.ts
msgid "The same line repeats on every page."
msgstr "បន្ទាត់ដដែលកើតឡើងម្តងទៀតនៅលើគ្រប់ទំព័រ។"

#: src/features/settings/ProviderScreen.tsx
msgid "The saved key isn't sent to a new base URL. Enter it again."
msgstr "សោដែលបានរក្សាទុកមិនត្រូវបានផ្ញើទៅកាន់ URL មូលដ្ឋានថ្មីទេ។ បញ្ចូលសោម្តងទៀត។"

#: src/features/builder/check/CheckScreen.tsx
msgid "The score counts how reliably software reads your resume. It doesn't predict whether you'll be shortlisted."
msgstr "ពិន្ទុរាប់ពីរបៀបដែលកម្មវិធីដែលអាចទុកចិត្តបានអានប្រវត្តិរូបសង្ខេបរបស់អ្នក។ វាមិនទស្សន៍ទាយថាតើអ្នកនឹងត្រូវជាប់ក្នុងបញ្ជីសម្រាំងទេ។"

#: src/data/failures.ts
msgid "The server didn't respond"
msgstr "ម៉ាស៊ីនមេមិនឆ្លើយតប"

#: src/features/settings/providers.ts
msgid "The service couldn't be reached. Check the address and connection, then try again."
msgstr "មិនអាចភ្ជាប់ទៅសេវាបានទេ។ ពិនិត្យអាសយដ្ឋាន និងការតភ្ជាប់ រួចព្យាយាមម្ដងទៀត។"

#: src/features/public/ats-messages.ts
msgid "The text comes out unreadable."
msgstr "អត្ថបទចេញមកមិនអាចអានបានទេ។"

#: src/features/public/ats-messages.ts
msgid "The top of the first page does not look like a name."
msgstr "ផ្នែកខាងលើនៃទំព័រទីមួយមិនមើលទៅដូចជាឈ្មោះទេ។"

#: src/features/settings/PreferencesScreen.tsx
msgid "Theme"
msgstr "ស្បែក"

#: src/features/public/ats-messages.ts
msgid "There is a gap between two dated roles."
msgstr "មានចន្លោះមួយរវាងតួនាទីពីរដែលមានកាលបរិច្ឆេទ។"

#: src/features/public/ats-messages.ts
msgid "There is no link to a profile, portfolio or repository."
msgstr "គ្មានតំណភ្ជាប់ទៅកាន់ប្រវត្តិរូប ផលប័ត្រ ឬឃ្លាំងកូដទេ។"

#: src/features/public/ats-messages.ts
msgid "There is no summary paragraph."
msgstr "គ្មានកថាខណ្ឌសង្ខេបទេ។"

#: src/features/documents/trash.tsx
msgid "They can't be restored."
msgstr "មិនអាចស្តារពួកវាវិញទេ។"

#: src/features/builder/check/issues.ts
msgid "They look for headings such as Experience, Education and Skills."
msgstr "ពួកគេស្វែងរកចំណងជើងដូចជា បទពិសោធន៍ ការអប់រំ និងជំនាញ។"

#: src/features/career/coach.tsx
msgid "Thinking"
msgstr "កំពុងគិត"

#: src/features/workspace/FitScreen.tsx
msgid "This application has no posting saved yet. Paste it to check fit."
msgstr "ពាក្យសុំនេះមិនទាន់មានប្រកាសរក្សាទុក។ បិទភ្ជាប់ដើម្បីពិនិត្យភាពសមរម្យ។"

#: src/features/applications/DetailScreen.tsx
msgid "This application is closed"
msgstr "ពាក្យសុំនេះបានបិទ"

#: src/features/career/coach.tsx
msgid "This can't be undone."
msgstr "មិនអាចត្រឡប់វិញបានទេ។"

#: src/features/auth/ConsentScreen.tsx
msgid "This connection request is invalid or has expired. Start the connection again from your client."
msgstr "សំណើតភ្ជាប់នេះមិនត្រឹមត្រូវ ឬបានផុតកំណត់។ ចាប់ផ្តើមការតភ្ជាប់ម្តងទៀតពីកម្មវិធីអតិថិជនរបស់អ្នក។"

#: src/features/settings/first-send.ts
msgid "This conversation"
msgstr "ការសន្ទនានេះ"

#. placeholder {0}: new URL(server).host
#: src/features/settings/DeleteAccountDialog.tsx
msgid "This deletes your documents, applications, career knowledge and public pages from {0}. It can't be undone."
msgstr "វាលុបឯកសារ ពាក្យសុំ ចំណេះដឹងអាជីព និងទំព័រសាធារណៈអ្នកពី {0}។ មិនអាចត្រឡប់វិញបានទេ។"

#: src/api/ai-consent.ts
msgid "This enables recurring processing while the schedule is on, using your server's selected providers. Turn the schedule off to stop future runs."
msgstr "វាបើកដំណើរការដំណើរការឡើងវិញ ខណៈពេលដែលកាលវិភាគបើក ដោយប្រើអ្នកផ្តល់សេវាដែលបានជ្រើសរើសរបស់ម៉ាស៊ីនមេរបស់អ្នក។ បិទកាលវិភាគដើម្បីបញ្ឈប់ការរត់នាពេលអនាគត។"

#: src/features/builder/check/issues.ts
msgid "This entry"
msgstr "ធាតុនេះ។"

#: src/features/public/ats-messages.ts
msgid "This file contains form fields."
msgstr "ឯកសារនេះមានវាលទម្រង់។"

#: src/features/public/ats-messages.ts
msgid "This file contains text drawn invisibly."
msgstr "ឯកសារនេះមានអត្ថបទដែលបានគូរដោយមើលមិនឃើញ។"

#: src/features/public/ats-messages.ts
msgid "This file contains white-on-white text."
msgstr "ឯកសារនេះមានអត្ថបទពណ៌ស​លើផ្ទៃពណ៌ស។"

#: src/data/import.ts
msgid "This file couldn't be read. Your file is kept."
msgstr "មិនអាចអានឯកសារនេះបាន។ ឯកសារអ្នកនៅរក្សាទុក។"

#: src/features/public/ats-messages.ts
msgid "This file declares no language."
msgstr "ឯកសារនេះមិនបានប្រកាសភាសាណាមួយទេ។"

#: src/features/public/ats-messages.ts
msgid "This file has no accessibility tags."
msgstr "ឯកសារនេះគ្មានស្លាកភាពងាយស្រួលប្រើប្រាស់ទេ។"

#: src/features/public/ats-messages.ts
msgid "This file is encrypted."
msgstr "ឯកសារនេះត្រូវបានអថេរបំលែង។"

#: src/features/public/ats-messages.ts
msgid "This file is large for a resume."
msgstr "ឯកសារនេះធំសម្រាប់ជាប្រវត្តិរូបសង្ខេប។"

#: src/features/public/ats-messages.ts
msgid "This file is larger than many application forms accept."
msgstr "ឯកសារនេះធំជាងអ្វីដែលទម្រង់ដាក់ពាក្យជាច្រើនអនុញ្ញាត។"

#: src/features/public/ats-messages.ts
msgid "This file uses a lot of different fonts."
msgstr "ឯកសារនេះប្រើពុម្ពអក្សរផ្សេងគ្នាជាច្រើន។"

#: src/features/public/ats-messages.ts
msgid "This file uses Type 3 fonts, which carry drawings instead of characters."
msgstr "ឯកសារនេះប្រើពុម្ពអក្សរ Type 3 ដែលផ្ទុករូបគូរជំនួសឱ្យតួអក្សរ។"

#: src/features/public/ats-messages.ts
msgid "This is a PDF Portfolio: the visible page is only a cover."
msgstr "នេះជា PDF Portfolio៖ ទំព័រដែលមើលឃើញគឺគ្រាន់តែជាគម្រប។"

#: src/features/public/ats-messages.ts
msgid "This is an XFA form, so most software reads only the empty shell."
msgstr "នេះជាទម្រង់ XFA ដូច្នេះកម្មវិធីភាគច្រើនអានតែសំបកទទេប៉ុណ្ណោះ។"

#: src/features/public/resume.tsx
msgid "This is how visitors see it"
msgstr "នេះជាអ្វីដែលអ្នកទស្សនាឃើញ"

#: src/features/public/ats-messages.ts
msgid "This is not a common resume page size."
msgstr "នេះមិនមែនជាទំហំទំព័រប្រវត្តិរូបសង្ខេបធម្មតាទេ។"

#: src/features/public/ats-messages.ts
msgid "This page is in columns, and the text extracts out of order."
msgstr "ទំព័រនេះស្ថិតនៅក្នុងជួរឈរ ហើយអត្ថបទត្រូវបានស្រង់ចេញក្រៅលំដាប់។"

#: src/features/public/ats-messages.ts
msgid "This page is very densely packed."
msgstr "ទំព័រនេះត្រូវបានវេចខ្ចប់យ៉ាងក្រាស់។"

#: src/data/ats-check.ts
msgid "This PDF is password protected. Save an unprotected copy and try again."
msgstr "PDF នេះត្រូវបានការពារដោយពាក្យសម្ងាត់។ រក្សាទុកច្បាប់ចម្លងដែលមិនបានការពារ ហើយសាកល្បងម្តងទៀត។"

#: src/features/builder/assistant/assistant-screen.tsx
msgid "This resume"
msgstr "ប្រវត្តិរូបនេះ"

#: src/features/public/ats-messages.ts
msgid "This resume is long."
msgstr "ប្រវត្តិរូបសង្ខេបនេះវែង។"

#: src/features/public/resume.tsx
msgid "This resume is password protected. Open its public link in your browser to enter the password."
msgstr "ប្រវត្តិរូបនេះការពារដោយពាក្យសម្ងាត់។ បើកតំណសាធារណៈក្នុងកម្មវិធីរុករកដើម្បីបញ្ចូលពាក្យសម្ងាត់។"

#: src/features/public/resume.tsx
msgid "This resume isn't shared right now."
msgstr "ប្រវត្តិរូបសង្ខេបនេះមិនត្រូវបានចែករំលែកនៅពេលនេះទេ។"

#: src/features/settings/AccountScreen.tsx
msgid "This server can't send email, so the address can't be changed here. Ask the person who runs it."
msgstr "ម៉ាស៊ីនមេនេះមិនអាចផ្ញើអ៊ីមែលបានទេ ដូច្នេះមិនអាចប្តូរអាសយដ្ឋាននៅទីនេះបានទេ។ សុំអ្នកដែលគ្រប់គ្រងវា។"

#: src/api/ai-consent.ts
msgid "This server cannot confirm reading without AI. Save the posting manually or update the server."
msgstr "ម៉ាស៊ីនមេនេះមិនអាចបញ្ជាក់ការអានដោយគ្មាន AI បានទេ។ រក្សាទុកប្រកាសការងារដោយដៃ ឬធ្វើបច្ចុប្បន្នភាពម៉ាស៊ីនមេ។"

#: src/auth/messages.ts
msgid "This server is too old for the app. Ask your administrator to update it."
msgstr "ម៉ាស៊ីនមេនេះចាស់ពេកសម្រាប់កម្មវិធី។ សួរអ្នកគ្រប់គ្រងរបស់អ្នកដើម្បីធ្វើបច្ចុប្បន្នភាពវា។"

#: src/api/ai-consent.ts
msgid "This server or AI connection doesn't support native web search."
msgstr "ម៉ាស៊ីនមេ ឬការតភ្ជាប់ AI នេះមិនគាំទ្រការស្វែងរកវេបផ្ទាល់របស់អ្នកផ្តល់សេវាទេ។"

