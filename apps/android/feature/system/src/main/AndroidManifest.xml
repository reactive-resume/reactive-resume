<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- MissingClass: the app shell supplies this activity; :app:assembleDebug verifies the merged target. -->
        <activity android:name="me.rxresu.MainActivity" android:exported="true" tools:ignore="MissingClass">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rxresu.me" android:pathPrefix="/builder/" />
                <data android:scheme="https" android:host="rxresu.me" android:pathPrefix="/feedback/" />
            </intent-filter>
        </activity>
        <activity-alias android:name="me.rxresu.feature.system.SaveJob" android:targetActivity="me.rxresu.MainActivity" android:label="@string/system_savejob" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="me.rxresu.feature.system.CheckPdf" android:targetActivity="me.rxresu.MainActivity" android:label="@string/system_checkpdf" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="me.rxresu.feature.system.ImportResume" android:targetActivity="me.rxresu.MainActivity" android:label="@string/system_importresume" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>
        <!-- Public username paths cannot exclude /auth on older Android versions. The explicit builder and feedback filters above work on all supported SDKs. -->
        <activity-alias android:name="me.rxresu.feature.system.PublicLinks" android:targetActivity="me.rxresu.MainActivity" android:exported="true" android:enabled="@bool/system_precise_app_links" tools:targetApi="35">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rxresu.me" />
                <uri-relative-filter-group android:allow="false"><data android:path="/auth" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/auth/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/api" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/api/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/mcp" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/mcp/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/uploads" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/uploads/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/dashboard" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/dashboard/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/.well-known" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/.well-known/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/templates" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/templates/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/agent" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/agent/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/docs" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/docs/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/builder" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/builder/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/feedback" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/feedback/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/ats-checker" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/ats-checker/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/privacy" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/privacy/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/terms" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/terms/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/pricing" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/pricing/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/changelog" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/changelog/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/assets" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/assets/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/fonts" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/fonts/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/logo" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/logo/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/favicon.ico" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/favicon.ico/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/robots.txt" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/robots.txt/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:path="/sitemap.xml" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/sitemap.xml/" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="true"><data android:pathAdvancedPattern="/[^/]+" /></uri-relative-filter-group>
                <uri-relative-filter-group android:allow="true"><data android:pathAdvancedPattern="/[^/]+/[^/]+" /></uri-relative-filter-group>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="me.rxresu.feature.system.AliasLinks" android:targetActivity="me.rxresu.MainActivity" android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rx.cv" />
            </intent-filter>
        </activity-alias>
        <receiver android:name="me.rxresu.feature.system.TodayWidgetReceiver" android:exported="true" android:label="@string/system_today_widget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>
        <receiver android:name="me.rxresu.feature.system.NextInterviewWidgetReceiver" android:exported="true" android:label="@string/system_next_interview_widget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/next_interview_widget_info" />
        </receiver>
        <receiver android:name="me.rxresu.feature.system.LogFollowUpReceiver" android:exported="false" />
        <provider android:name="me.rxresu.feature.system.SharedPdfProvider" android:authorities="${applicationId}.shared-pdfs" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_pdf_paths" />
        </provider>
    </application>
</manifest>
