{
	"$schema": "https://v2-11-5.turborepo.dev/schema.json",
	"ui": "stream",
	"boundaries": {
		"dependencies": {
			"deny": ["web", "server"]
		},
		"implicitDependencies": [
			"vite-plus",
			"@testing-library/jest-dom",
			"@testing-library/react",
			"@testing-library/user-event"
		],
		"tags": {
			"app:server": {
				"dependencies": {
					"deny": ["app:web", "runtime:browser"]
				}
			},
			"app:mobile": {
				"dependencies": {
					"deny": ["app:server", "app:web", "runtime:server", "runtime:browser"]
				}
			},
			"runtime:server": {
				"dependencies": {
					"deny": ["app:web", "runtime:browser"]
				}
			},
			"runtime:browser": {
				"dependencies": {
					"deny": ["app:server", "runtime:server"]
				}
			},
			"runtime:native": {
				"dependencies": {
					"deny": ["app:web", "app:server", "runtime:server", "runtime:browser"]
				}
			},
			"runtime:universal": {
				"dependencies": {
					"deny": ["app:web", "app:server", "runtime:server"]
				}
			},
			"role:domain": {
				"dependencies": {
					"deny": ["app:web", "app:server", "role:adapter", "role:infra"]
				}
			},
			"role:ui": {
				"dependencies": {
					"deny": ["app:web", "app:server", "runtime:server", "role:infra"]
				}
			}
		}
	},
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/.env*", "!$TURBO_ROOT$/.env.example"],
			"outputs": ["dist/**", ".vercel/**"],
			"dependsOn": ["transit"],
			"env": ["NODE_ENV"]
		},
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"test": {
			"dependsOn": ["transit"],
			"env": [
				"PORT",
				"SERVER_PORT",
				"APP_URL",
				"APP_REVISION",
				"ROOT_RESUME_ID",
				"APP_ALIAS_URL",
				"CUSTOM_DOMAIN_TARGET",
				"CUSTOM_DOMAIN_PROVIDER_SECRET",
				"WEB_FONT_BASE_URL",
				"DATABASE_*",
				"AUTH_SECRET",
				"TRUSTED_PROXIES",
				"BETTER_AUTH_*",
				"APPLE_CLIENT_*",
				"MOBILE_*",
				"GOOGLE_CLIENT_*",
				"GITHUB_CLIENT_*",
				"LINKEDIN_CLIENT_*",
				"OAUTH_*",
				"SMTP_*",
				"LOCAL_STORAGE_PATH",
				"S3_*",
				"REDIS_URL",
				"ENCRYPTION_SECRET",
				"WEB_ACCESS_*",
				"WEB_SEARCH_SEARXNG_URL",
				"FIRECRAWL_*",
				"AI_*",
				"FLAG_*",
				"CRON_SECRET",
				"STRICT_SCHEMA_CHECK",
				"CLOUDFLARE",
				"VERCEL",
				"VERCEL_ENV",
				"VERCEL_URL",
				"VERCEL_PROJECT_PRODUCTION_URL",
				"VERCEL_BRANCH_URL",
				"POSTGRES_*",
				"KV_URL",
				"STORAGE_BACKEND",
				"STORAGE_HEALTHCHECK_TIMEOUT_MS",
				"BLOB_*",
				"DEPLOYMENT_NAMESPACE",
				"ALLOW_PREVIEW_MIGRATIONS",
				"NODE_ENV"
			],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"]
		},
		"test:coverage": {
			"dependsOn": ["transit"],
			"env": [
				"PORT",
				"SERVER_PORT",
				"APP_URL",
				"APP_REVISION",
				"ROOT_RESUME_ID",
				"APP_ALIAS_URL",
				"CUSTOM_DOMAIN_TARGET",
				"CUSTOM_DOMAIN_PROVIDER_SECRET",
				"WEB_FONT_BASE_URL",
				"DATABASE_*",
				"AUTH_SECRET",
				"TRUSTED_PROXIES",
				"BETTER_AUTH_*",
				"APPLE_CLIENT_*",
				"MOBILE_*",
				"GOOGLE_CLIENT_*",
				"GITHUB_CLIENT_*",
				"LINKEDIN_CLIENT_*",
				"OAUTH_*",
				"SMTP_*",
				"LOCAL_STORAGE_PATH",
				"S3_*",
				"REDIS_URL",
				"ENCRYPTION_SECRET",
				"WEB_ACCESS_*",
				"WEB_SEARCH_SEARXNG_URL",
				"FIRECRAWL_*",
				"AI_*",
				"FLAG_*",
				"CRON_SECRET",
				"STRICT_SCHEMA_CHECK",
				"CLOUDFLARE",
				"VERCEL",
				"VERCEL_ENV",
				"VERCEL_URL",
				"VERCEL_PROJECT_PRODUCTION_URL",
				"VERCEL_BRANCH_URL",
				"POSTGRES_*",
				"KV_URL",
				"STORAGE_BACKEND",
				"STORAGE_HEALTHCHECK_TIMEOUT_MS",
				"BLOB_*",
				"DEPLOYMENT_NAMESPACE",
				"ALLOW_PREVIEW_MIGRATIONS",
				"NODE_ENV"
			],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
			"outputs": ["coverage/**"]
		},
		"test:ci": {
			"dependsOn": ["transit"],
			"env": [
				"PORT",
				"SERVER_PORT",
				"APP_URL",
				"APP_REVISION",
				"ROOT_RESUME_ID",
				"APP_ALIAS_URL",
				"CUSTOM_DOMAIN_TARGET",
				"CUSTOM_DOMAIN_PROVIDER_SECRET",
				"WEB_FONT_BASE_URL",
				"DATABASE_*",
				"AUTH_SECRET",
				"TRUSTED_PROXIES",
				"BETTER_AUTH_*",
				"APPLE_CLIENT_*",
				"MOBILE_*",
				"GOOGLE_CLIENT_*",
				"GITHUB_CLIENT_*",
				"LINKEDIN_CLIENT_*",
				"OAUTH_*",
				"SMTP_*",
				"LOCAL_STORAGE_PATH",
				"S3_*",
				"REDIS_URL",
				"ENCRYPTION_SECRET",
				"WEB_ACCESS_*",
				"WEB_SEARCH_SEARXNG_URL",
				"FIRECRAWL_*",
				"AI_*",
				"FLAG_*",
				"CRON_SECRET",
				"STRICT_SCHEMA_CHECK",
				"CLOUDFLARE",
				"VERCEL",
				"VERCEL_ENV",
				"VERCEL_URL",
				"VERCEL_PROJECT_PRODUCTION_URL",
				"VERCEL_BRANCH_URL",
				"POSTGRES_*",
				"KV_URL",
				"STORAGE_BACKEND",
				"STORAGE_HEALTHCHECK_TIMEOUT_MS",
				"BLOB_*",
				"DEPLOYMENT_NAMESPACE",
				"ALLOW_PREVIEW_MIGRATIONS",
				"NODE_ENV"
			],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
			"outputs": ["reports/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"lingui:extract": {
			"cache": false
		}
	},
	"globalDependencies": ["vitest.shared.mts", "vitest.setup.ts", "vite.config.ts"],
	"globalPassThroughEnv": [
		"PORT",
		"SERVER_PORT",
		"APP_URL",
		"APP_REVISION",
		"ROOT_RESUME_ID",
		"APP_ALIAS_URL",
		"CUSTOM_DOMAIN_TARGET",
		"CUSTOM_DOMAIN_PROVIDER_SECRET",
		"WEB_FONT_BASE_URL",
		"DATABASE_URL",
		"AUTH_SECRET",
		"TRUSTED_PROXIES",
		"BETTER_AUTH_API_KEY",
