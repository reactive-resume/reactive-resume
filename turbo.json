		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"LINKEDIN_CLIENT_ID",
		"LINKEDIN_CLIENT_SECRET",
		"OAUTH_PROVIDER_NAME",
		"OAUTH_CLIENT_ID",
		"OAUTH_CLIENT_SECRET",
		"OAUTH_DISCOVERY_URL",
		"OAUTH_AUTHORIZATION_URL",
		"OAUTH_TOKEN_URL",
		"OAUTH_USER_INFO_URL",
		"OAUTH_SCOPES",
		"SMTP_HOST",
		"SMTP_PORT",
		"SMTP_USER",
		"SMTP_PASS",
		"SMTP_FROM",
		"SMTP_SECURE",
		"LOCAL_STORAGE_PATH",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"S3_REGION",
		"S3_ENDPOINT",
		"S3_BUCKET",
		"S3_FORCE_PATH_STYLE",
		"REDIS_URL",
		"ENCRYPTION_SECRET",
		"WEB_ACCESS_PROVIDER",
		"WEB_ACCESS_API_KEY",
		"WEB_ACCESS_API_URL",
		"WEB_SEARCH_SEARXNG_URL",
		"AI_PROVIDER",
		"AI_MODEL",
		"AI_API_KEY",
		"AI_BASE_URL",
		"CRON_SECRET",
		"FLAG_DISABLE_SIGNUPS",
		"FLAG_DISABLE_EMAIL_AUTH",
