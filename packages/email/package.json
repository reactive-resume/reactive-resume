{
	"name": "@reactive-resume/email",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		"./transport": "./src/transport.ts",
		"./templates/auth": "./src/templates/auth.tsx"
	},
	"scripts": {
		"dev": "email dev --dir src/templates --port 3002",
		"typecheck": "tsrs --noEmit",
		"test": "vp test run --passWithNoTests",
		"test:coverage": "vp test run --coverage --passWithNoTests",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests"
	},
	"dependencies": {
		"@reactive-resume/env": "workspace:*",
		"nodemailer": "^10.2.1",
		"react": "catalog:",
		"react-email": "^6.11.3"
	},
	"devDependencies": {
		"@react-email/ui": "^6.11.3",
		"@reactive-resume/config": "workspace:*",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
